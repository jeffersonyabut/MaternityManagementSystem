<Window x:Class="MaternityManagementSystem.Dialogs.CustomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Golddie Dialog"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- Dialog action button style -->
        <Style x:Key="DialogButtonStyle"
               TargetType="Button">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FFF3F4F6"/>
            <Setter Property="Foreground" Value="#FF374151"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.7"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dialog input style -->
        <Style x:Key="DialogTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF171717"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFD1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FF2563EB"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#FF2563EB"/>
                                <Setter TargetName="InputBorder"
                                        Property="BorderThickness"
                                        Value="1.5"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="#FFFAFAFA"
            CornerRadius="16"
            Padding="28"
            BorderThickness="1"
            BorderBrush="#FFE5E7EB">

        <StackPanel>

            <!-- Dialog icon -->
            <Border x:Name="IconContainer"
                    Width="52"
                    Height="52"
                    CornerRadius="26"
                    Background="#FFDBEAFE"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,20">

                <TextBlock x:Name="IconText"
                           Text="!"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#FF2563EB"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Dialog title -->
            <TextBlock x:Name="TitleText"
                       Text="Dialog Title"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="#FF171717"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <!-- Dialog message -->
            <TextBlock x:Name="MessageText"
                       Text="Dialog message goes here."
                       FontSize="13.5"
                       Foreground="#FF525252"
                       Opacity="1"
                       TextWrapping="Wrap"
                       LineHeight="22"
                       Margin="0,0,0,22"/>

            <!-- Optional input -->
            <TextBox x:Name="InputTextBox"
                     Style="{StaticResource DialogTextBoxStyle}"
                     Visibility="Collapsed"
                     MinHeight="44"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,22"/>

            <!-- Dialog actions -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="CancelButton"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="Cancel"
                        Margin="0,0,10,0"
                        IsCancel="True"/>

                <Button x:Name="ConfirmButton"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="Confirm"
                        IsDefault="True"/>

            </StackPanel>

        </StackPanel>
    </Border>
</Window>
