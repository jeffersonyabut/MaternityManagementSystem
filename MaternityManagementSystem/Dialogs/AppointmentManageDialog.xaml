<Window x:Class="MaternityManagementSystem.Dialogs.AppointmentManageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Appointment"
        Width="650"
        Height="760"
        MinWidth="580"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#6554C0"/>
        <SolidColorBrush x:Key="TextBrush" Color="#25243A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#85849A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#EAEAF1"/>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#EAEAF1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#85849A"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E4E3EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E4E3EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#55546A"/>
            <Setter Property="BorderBrush" Value="#E4E3EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="#FFF6F7FB"
            CornerRadius="16"
            BorderBrush="#FFEAEAF1"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="16,16,0,0"
                    Padding="24,20"
                    BorderBrush="#FFEAEAF1"
                    BorderThickness="0,0,0,1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Manage Appointment"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="Update appointment details, schedule, and status."
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="GOLDDIE"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- CONTENT -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,20">

                <StackPanel>

                    <!-- PATIENT SUMMARY -->

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="PATIENT INFORMATION"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,0,0,14"/>

                            <TextBlock x:Name="PatientNameText"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>

                            <TextBlock x:Name="PatientNumberText"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- APPOINTMENT DETAILS -->

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="APPOINTMENT DETAILS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="Appointment Date"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <DatePicker x:Name="AppointmentDatePicker"
                                        Height="38"
                                        FontSize="12"
                                        Padding="8,5"
                                        Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Start Time"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBox x:Name="StartTimeTextBox"
                                             Style="{StaticResource FieldInputStyle}"
                                             ToolTip="Example: 09:00 AM"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Margin="8,0,0,0">
                                    <TextBlock Text="End Time"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBox x:Name="EndTimeTextBox"
                                             Style="{StaticResource FieldInputStyle}"
                                             ToolTip="Example: 09:30 AM"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Appointment Purpose"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox x:Name="PurposeTextBox"
                                     Style="{StaticResource FieldInputStyle}"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="Appointment Notes"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox x:Name="NotesTextBox"
                                     Height="85"
                                     Padding="10,8"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderBrush="#E4E3EB"
                                     BorderThickness="1"
                                     Background="White"/>
                        </StackPanel>
                    </Border>

                    <!-- STATUS -->

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="APPOINTMENT STATUS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,0,0,14"/>

                            <TextBlock Text="Current / New Status"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <ComboBox x:Name="StatusComboBox"
                                      Style="{StaticResource FieldComboBoxStyle}"
                                      ItemsSource="{Binding StatusOptions}"/>
                        </StackPanel>
                    </Border>

                    <!-- ACTION INFORMATION -->

                    <Border Background="#FFF8F7FC"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,14">

                        <StackPanel>
                            <TextBlock Text="IMPORTANT"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="Cancelling or archiving an appointment requires a reason. These actions are handled separately from saving ordinary appointment changes."
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- FOOTER -->

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="0,0,16,16"
                    Padding="20,16"
                    BorderBrush="#FFEAEAF1"
                    BorderThickness="0,1,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,14">

                        <Button Content="Cancel Appointment"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Foreground="#C44958"
                                Margin="0,0,8,0"
                                Click="CancelAppointment_Click"/>

                        <Button Content="Archive"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Foreground="#77768B"
                                Click="ArchiveAppointment_Click"/>
                    </WrapPanel>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Close"
                                Width="90"
                                Height="38"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                IsCancel="True"
                                Click="CloseButton_Click"/>

                        <Button Content="Save Changes"
                                Width="120"
                                Height="38"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="SaveChanges_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
