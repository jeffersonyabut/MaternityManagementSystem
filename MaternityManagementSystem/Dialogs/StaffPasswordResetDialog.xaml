<Window x:Class="MaternityManagementSystem.Dialogs.StaffPasswordResetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Staff Password"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <Style x:Key="ResetPasswordBoxStyle"
               TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF171717"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFD1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ResetButtonStyle"
               TargetType="Button">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FFF3F4F6"/>
            <Setter Property="Foreground" Value="#FF374151"/>
        </Style>

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF374151"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

    </Window.Resources>

    <Border Background="#FFFAFAFA"
            CornerRadius="16"
            Padding="28"
            BorderThickness="1"
            BorderBrush="#FFE5E7EB">

        <StackPanel>

            <!-- Header -->
            <Border Width="52"
                    Height="52"
                    CornerRadius="26"
                    Background="#FFFFF3E0"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,18">

                <TextBlock Text="&#x1F511;"
                           FontSize="23"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Reset Staff Password"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="#FF171717"
                       Margin="0,0,0,7"/>

            <TextBlock Text="Set a new password for the selected staff account."
                       FontSize="13"
                       Foreground="#FF6B7280"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24"/>

            <!-- New password -->
            <TextBlock Text="NEW PASSWORD"
                       Style="{StaticResource FieldLabelStyle}"/>

            <PasswordBox x:Name="NewPasswordBox"
                         Style="{StaticResource ResetPasswordBoxStyle}"
                         MaxLength="1024"
                         Margin="0,0,0,17"/>

            <!-- Confirm password -->
            <TextBlock Text="CONFIRM NEW PASSWORD"
                       Style="{StaticResource FieldLabelStyle}"/>

            <PasswordBox x:Name="ConfirmPasswordBox"
                         Style="{StaticResource ResetPasswordBoxStyle}"
                         MaxLength="1024"
                         Margin="0,0,0,7"/>

            <TextBlock Text="Password must contain at least 8 characters."
                       FontSize="11"
                       Foreground="#FF85849A"
                       Margin="0,0,0,17"/>

            <!-- Validation -->
            <TextBlock x:Name="ValidationText"
                       Foreground="#FFDC2626"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18"
                       Visibility="Collapsed"/>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource ResetButtonStyle}"
                        Margin="0,0,10,0"
                        IsCancel="True"/>

                <Button x:Name="ResetButton"
                        Content="Reset Password"
                        Style="{StaticResource ResetButtonStyle}"
                        Background="#FF6554C0"
                        Foreground="White"
                        IsDefault="True"/>

            </StackPanel>

        </StackPanel>
    </Border>

</Window>
