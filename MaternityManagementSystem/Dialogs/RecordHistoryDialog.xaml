<Window x:Class="MaternityManagementSystem.Dialogs.RecordHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record History"
        Width="760"
        Height="650"
        MinWidth="600"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="#FFFAFAFA"
            CornerRadius="16"
            Padding="28"
            BorderThickness="1"
            BorderBrush="#FFE5E7EB">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,20">

                <TextBlock x:Name="TitleText"
                           Text="Record History"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Foreground="#FF171717"/>

                <TextBlock x:Name="SubtitleText"
                           Text="Review previous changes made to this record."
                           FontSize="13"
                           Foreground="#FF737373"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- History content -->
            <Grid Grid.Row="1">

                <TextBlock x:Name="EmptyMessage"
                           Text="No record history available."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#FF737373"
                           FontSize="13"
                           Visibility="Collapsed"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl x:Name="HistoryItemsControl">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border BorderBrush="#FFE5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16"
                                        Margin="0,0,0,14">

                                    <StackPanel>

                                        <!-- Revision information -->
                                        <DockPanel Margin="0,0,0,16">

                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FF171717"/>

                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding ChangedAtUtc,
                                                       StringFormat={}{0:MMM dd, yyyy hh:mm tt}}"
                                                       FontSize="12"
                                                       Foreground="#FF737373"/>
                                        </DockPanel>

                                        <!-- Changed fields -->
                                        <ItemsControl ItemsSource="{Binding Changes}">

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>

                                                    <StackPanel Margin="0,0,0,14">

                                                        <TextBlock Text="{Binding FieldName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   Foreground="#FF374151"
                                                                   Margin="0,0,0,8"/>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Previous value -->
                                                            <Border Grid.Column="0"
                                                                    Background="#FFF3EEEE"
                                                                    CornerRadius="7"
                                                                    Padding="12"
                                                                    Margin="0,0,6,0">

                                                                <StackPanel>
                                                                    <TextBlock Text="PREVIOUS VALUE"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#FF8B5555"/>

                                                                    <TextBlock Text="{Binding PreviousValue}"
                                                                               FontSize="13"
                                                                               Foreground="#FF374151"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,5,0,0"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- New value -->
                                                            <Border Grid.Column="1"
                                                                    Background="#FFEAF4EC"
                                                                    CornerRadius="7"
                                                                    Padding="12"
                                                                    Margin="6,0,0,0">

                                                                <StackPanel>
                                                                    <TextBlock Text="NEW VALUE"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#FF367548"/>

                                                                    <TextBlock Text="{Binding NewValue}"
                                                                               FontSize="13"
                                                                               Foreground="#FF374151"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,5,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>

                                                    </StackPanel>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </StackPanel>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">

                <Button Content="Close"
                        MinWidth="90"
                        MinHeight="40"
                        Padding="18,9"
                        Background="#FFF3F4F6"
                        Foreground="#FF374151"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        IsCancel="True"/>

            </StackPanel>

        </Grid>
    </Border>
</Window>
