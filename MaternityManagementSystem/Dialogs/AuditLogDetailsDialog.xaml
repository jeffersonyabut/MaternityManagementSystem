<Window x:Class="MaternityManagementSystem.Dialogs.AuditLogDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activity Details"
        Width="620"
        Height="680"
        MinWidth="560"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F6F7FB"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#6554C0"/>
        <SolidColorBrush x:Key="TextBrush" Color="#25243A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#85849A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#EAEAF1"/>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#EAEAF1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#85849A"/>
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#25243A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#EAEAF1"
                BorderThickness="0,0,0,1"
                Padding="24,20">

            <StackPanel>
                <TextBlock Text="Activity Details"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBlock Text="Review the complete details of this recorded system activity."
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="24">

                <!-- ACTION SUMMARY -->
                <Border Style="{StaticResource SectionCardStyle}"
                        Margin="0,0,0,14">

                    <StackPanel>
                        <TextBlock Text="RECORDED ACTION"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="ActionText"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#6554C0"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="TimestampText"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- RECORD INFORMATION -->
                <Border Style="{StaticResource SectionCardStyle}"
                        Margin="0,0,0,14">

                    <StackPanel>
                        <TextBlock Text="RECORD INFORMATION"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ROW 1 -->
                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,12,20">
                                <TextBlock Text="STAFF ACCOUNT"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock x:Name="UsernameText"
                                           Style="{StaticResource FieldValueStyle}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="12,0,0,20">
                                <TextBlock Text="ENTITY TYPE"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock x:Name="EntityTypeText"
                                           Style="{StaticResource FieldValueStyle}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- ROW 2 -->
                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,12,0">
                                <TextBlock Text="RECORD ID"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock x:Name="EntityIdText"
                                           Style="{StaticResource FieldValueStyle}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="12,0,0,0">
                                <TextBlock Text="AUDIT LOG ID"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock x:Name="AuditLogIdText"
                                           Style="{StaticResource FieldValueStyle}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ACTIVITY DETAILS -->
                <Border Style="{StaticResource SectionCardStyle}"
                        Margin="0,0,0,14">

                    <StackPanel>
                        <TextBlock Text="ACTIVITY DETAILS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <TextBlock x:Name="DetailsText"
                                   Style="{StaticResource FieldValueStyle}"
                                   TextWrapping="Wrap"
                                   MinHeight="35"/>
                    </StackPanel>
                </Border>

                <!-- REASON -->
                <Border x:Name="ReasonSection"
                        Style="{StaticResource SectionCardStyle}">

                    <StackPanel>
                        <TextBlock Text="REASON"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <TextBlock x:Name="ReasonText"
                                   Style="{StaticResource FieldValueStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#EAEAF1"
                BorderThickness="0,1,0,0"
                Padding="24,14">

            <Grid>
                <TextBlock Text="READ-ONLY AUDIT RECORD"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>

                <Button Content="Close"
                        Width="100"
                        Height="36"
                        HorizontalAlignment="Right"
                        Background="#6554C0"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
