<UserControl x:Class="MaternityManagementSystem.Views.PatientMasterListReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:converters="clr-namespace:MaternityManagementSystem.Converters"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <converters:RegionalDateOnlyConverter
            x:Key="RegionalDateOnlyConverter"/>

        <converters:RegionalDateTimeConverter
            x:Key="RegionalDateTimeConverter"/>

        <Style x:Key="ReportLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555064"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="ReportInputStyle" TargetType="Control">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28">

            <!-- Navigation -->
            <Button Content="← Back to Reports"
                    HorizontalAlignment="Left"
                    Padding="12,7"
                    Margin="0,0,0,24"
                    Click="BackButton_Click"/>

            <!-- Header -->
            <TextBlock Text="GOLDDIE · CLINIC MANAGEMENT"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#7952B3"/>

            <TextBlock Text="Patient Master List"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#29243B"
                       Margin="0,5,0,0"/>

            <TextBlock Text="Generate and preview registered patient records."
                       FontSize="13"
                       Foreground="#777184"
                       Margin="0,5,0,24"/>

            <!-- Report Configuration -->
            <Border Background="White"
                    BorderBrush="#EAE7F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Report Configuration"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#29243B"/>

                    <TextBlock Text="Apply filters to customize the patient records included in your report."
                               FontSize="13"
                               Foreground="#777184"
                               TextWrapping="Wrap"
                               Margin="0,7,0,22"/>

                    <!-- Date Filters -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Registration Date · From"
                                       Style="{StaticResource ReportLabelStyle}"/>

                            <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,16"
                                        MinHeight="38"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Registration Date · To"
                                       Style="{StaticResource ReportLabelStyle}"/>

                            <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,16"
                                        MinHeight="38"/>
                        </StackPanel>
                    </Grid>

                    <!-- Sex Filter -->
                    <TextBlock Text="Sex"
                               Style="{StaticResource ReportLabelStyle}"/>

                    <ComboBox ItemsSource="{Binding SexOptions}"
                              SelectedItem="{Binding SelectedSex, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,16"
                              MinHeight="38"
                              Padding="9,6"/>

                    <!-- Search -->
                    <TextBlock Text="Search Patient"
                               Style="{StaticResource ReportLabelStyle}"/>

                    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="38"
                             Padding="9,6"
                             Margin="0,0,0,20"
                             ToolTip="Search by patient number or patient name"/>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Clear Filters"
                                Command="{Binding ClearFiltersCommand}"
                                Padding="18,10"
                                Margin="0,0,10,0"/>

                        <Button Content="Generate Report"
                                Command="{Binding GenerateReportCommand}"
                                Padding="18,10"
                                Background="#7952B3"
                                Foreground="White"/>

                    </StackPanel>

                    <!-- Loading -->
                    <TextBlock Text="Generating report..."
                               Foreground="#7952B3"
                               FontSize="12"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Right"
                               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Error -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#C62828"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                </StackPanel>
            </Border>

            <!-- Report Preview -->
            <Border Background="White"
                    BorderBrush="#EAE7F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">

                <StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Report Preview"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#29243B"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Print Preview"
                                Click="PrintPreviewButton_Click"
                                Padding="16,9"
                                Background="#7952B3"
                                Foreground="White"
                                IsEnabled="{Binding HasGeneratedReport}"/>
                    </Grid>

                    <!-- Initial Instruction -->
                    <TextBlock Text="Generate a report to display matching patient records."
                               Foreground="#777184"
                               FontSize="13"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,24,0,12">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGeneratedReport}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Report Summary -->
                    <Border Background="#F8F6FB"
                            BorderBrush="#EAE7F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,12,0,18">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGeneratedReport}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>

                            <TextBlock Text="REPORT SUMMARY"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#7952B3"
                                       Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Generated Date -->
                                <StackPanel Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,12,12">

                                    <TextBlock Text="Generated"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding Report.GeneratedAtUtc,
                                                              Converter={StaticResource RegionalDateTimeConverter}}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#29243B"/>
                                </StackPanel>

                                <!-- Registration Range -->
                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,0,0,12">

                                    <TextBlock Text="Registration Date Range"
                                               FontSize="11"
                                               Foreground="#777184"
                                               Margin="0,0,0,6"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,16,0">

                                            <TextBlock Text="From"
                                                       FontSize="10"
                                                       Foreground="#777184"/>

                                            <TextBlock Text="{Binding Report.StartDate,
                                                                      Converter={StaticResource RegionalDateOnlyConverter},
                                                                      TargetNullValue=Any}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#29243B"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">

                                            <TextBlock Text="To"
                                                       FontSize="10"
                                                       Foreground="#777184"/>

                                            <TextBlock Text="{Binding Report.EndDate,
                                                                      Converter={StaticResource RegionalDateOnlyConverter},
                                                                      TargetNullValue=Any}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#29243B"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Sex -->
                                <StackPanel Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,0,12,12">

                                    <TextBlock Text="Sex"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding Report.Sex,
                                                              TargetNullValue=All}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#29243B"/>
                                </StackPanel>

                                <!-- Search -->
                                <StackPanel Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,0,0,12">

                                    <TextBlock Text="Search Term"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding Report.SearchTerm,
                                                              TargetNullValue=None}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#29243B"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Total -->
                                <StackPanel Grid.Row="2"
                                            Grid.Column="0">

                                    <TextBlock Text="Total Matching Patients"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding Report.TotalPatients}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#7952B3"/>
                                </StackPanel>

                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- No Matching Records -->
                    <TextBlock Text="No matching patient records found."
                               Foreground="#777184"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Margin="0,24,0,24">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoMatchingPatients}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Patient Records DataGrid -->
                    <DataGrid ItemsSource="{Binding Report.Patients}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              MinHeight="180"
                              MaxHeight="500"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPatients}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Patient No."
                                                Binding="{Binding PatientNumber}"
                                                Width="110"/>

                            <DataGridTemplateColumn Header="Full Name"
                                                    Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1} {2}">
                                                    <Binding Path="FirstName"/>
                                                    <Binding Path="MiddleName"/>
                                                    <Binding Path="LastName"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Date of Birth"
                                                Binding="{Binding DateOfBirth,
                                                                  Converter={StaticResource RegionalDateOnlyConverter}}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Sex"
                                                Binding="{Binding Sex}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Civil Status"
                                                Binding="{Binding CivilStatus}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Contact Number"
                                                Binding="{Binding ContactNumber}"
                                                Width="130"/>

                            <DataGridTextColumn Header="Address"
                                                Binding="{Binding Address}"
                                                Width="200"/>

                            <DataGridTextColumn Header="Registration Date"
                                                Binding="{Binding CreatedAtUtc,
                                                                  Converter={StaticResource RegionalDateTimeConverter}}"
                                                Width="165"/>

                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
