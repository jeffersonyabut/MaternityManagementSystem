<UserControl x:Class="MaternityManagementSystem.Views.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MaternityManagementSystem.Views"
             Background="Transparent">

    <Grid>

        <TabControl>
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Foreground" Value="#424242"/>
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="Padding" Value="20,12"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>


                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#000000"/>
                            <Setter Property="Background" Value="#EAEAEA"/>
                            <Setter Property="BorderBrush" Value="#000000"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                    </Style.Triggers>

                </Style>
            </TabControl.Resources>

            <TabItem Header="Patient List">
                <views:PatientListView />
            </TabItem>

            <TabItem Header="Register Patient">
                <views:PatientRegistrationView />
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
