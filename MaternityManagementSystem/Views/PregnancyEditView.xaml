<UserControl x:Class="MaternityManagementSystem.Views.PregnancyEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">
                <TextBlock Text="Edit Pregnancy Record"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Update the pregnancy information below."
                           Margin="0,6,0,0"
                           Opacity="0.7"/>
            </StackPanel>

            <!-- Form -->
            <Border Grid.Row="1"
                    Padding="24"
                    CornerRadius="10"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <TextBlock Text="Pregnancy Status"
                               Margin="0,0,0,6"
                               FontWeight="SemiBold"/>

                    <ComboBox SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Content"
                              Margin="0,0,0,18">
                        <ComboBoxItem Content="Current"/>
                        <ComboBoxItem Content="Completed"/>
                        <ComboBoxItem Content="Other"/>
                    </ComboBox>

                    <TextBlock Text="Last Menstrual Period"
                               Margin="0,0,0,6"
                               FontWeight="SemiBold"/>

                    <DatePicker SelectedDate="{Binding LastMenstrualPeriod, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,18"/>

                    <TextBlock Text="Estimated Due Date"
                               Margin="0,0,0,6"
                               FontWeight="SemiBold"/>

                    <DatePicker SelectedDate="{Binding EstimatedDueDate, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,18"/>

                    <TextBlock Text="Pregnancy End Date"
                               Margin="0,0,0,6"
                               FontWeight="SemiBold"/>

                    <DatePicker SelectedDate="{Binding PregnancyEndDate, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,18"/>

                    <TextBlock Text="Notes"
                               Margin="0,0,0,6"
                               FontWeight="SemiBold"/>

                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="100"
                             Padding="10"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,18"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Foreground="Firebrick"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Cancel"
                                Padding="16,8"
                                Margin="0,0,10,0"
                                Click="CancelButton_Click"/>

                        <Button Content="Save Changes"
                                Padding="16,8"
                                Command="{Binding SaveCommand}"
                                IsEnabled="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
