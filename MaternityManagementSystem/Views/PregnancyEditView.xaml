<UserControl x:Class="MaternityManagementSystem.Views.PregnancyEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <StackPanel>

                <!-- Header -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Edit Pregnancy Record"
                               FontSize="28"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Update the pregnancy information below."
                               Margin="0,6,0,0"
                               Opacity="0.7"/>
                </StackPanel>

                <Border Padding="24"
                        CornerRadius="10"
                        Background="{DynamicResource MaterialDesignPaper}">

                    <StackPanel>

                        <!-- Pregnancy Information -->
                        <TextBlock Text="Pregnancy Information"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Pregnancy Status"
                                   FontWeight="SemiBold"/>

                        <ComboBox SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Content"
                                  Margin="0,4,0,18">
                            <ComboBoxItem Content="Current"/>
                            <ComboBoxItem Content="Completed"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>

                        <TextBlock Text="Last Menstrual Period (LMP)"
                                   FontWeight="SemiBold"/>

                        <DatePicker SelectedDate="{Binding LastMenstrualPeriod, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,4,0,18"/>

                        <TextBlock Text="Estimated Due Date (EDD)"
                                   FontWeight="SemiBold"/>

                        <DatePicker SelectedDate="{Binding EstimatedDueDate, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,4,0,18"/>

                        <TextBlock Text="Pregnancy End Date"
                                   FontWeight="SemiBold"/>

                        <DatePicker SelectedDate="{Binding PregnancyEndDate, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,4,0,20"/>

                        <Separator Margin="0,4,0,20"/>

                        <!-- Obstetric Details -->
                        <TextBlock Text="Obstetric Details"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="These details are optional while the pregnancy is ongoing."
                                   FontSize="13"
                                   Opacity="0.7"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Pregnancy Outcome"
                                   FontWeight="SemiBold"/>

                        <ComboBox SelectedValue="{Binding PregnancyOutcome, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Content"
                                  Margin="0,4,0,16">
                            <ComboBoxItem Content="Live Birth"/>
                            <ComboBoxItem Content="Stillbirth"/>
                            <ComboBoxItem Content="Miscarriage"/>
                            <ComboBoxItem Content="Ectopic Pregnancy"/>
                            <ComboBoxItem Content="Molar Pregnancy"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>

                        <TextBlock Text="Delivery Method"
                                   FontWeight="SemiBold"/>

                        <ComboBox SelectedValue="{Binding DeliveryMethod, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Content"
                                  Margin="0,4,0,16">
                            <ComboBoxItem Content="Vaginal"/>
                            <ComboBoxItem Content="Cesarean Section"/>
                            <ComboBoxItem Content="Assisted Vaginal"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>

                        <TextBlock Text="Gestational Age at Pregnancy End (Weeks)"
                                   FontWeight="SemiBold"/>

                        <TextBox Text="{Binding GestationalAgeAtEndWeeks, UpdateSourceTrigger=LostFocus}"
                                 MaxLength="2"
                                 Margin="0,4,0,16"/>

                        <TextBlock Text="Additional Gestational Age Days (0–6)"
                                   FontWeight="SemiBold"/>

                        <TextBox Text="{Binding GestationalAgeAtEndDays, UpdateSourceTrigger=LostFocus}"
                                 MaxLength="1"
                                 Margin="0,4,0,16"/>

                        <TextBlock Text="Number of Infants"
                                   FontWeight="SemiBold"/>

                        <TextBox Text="{Binding NumberOfInfants, UpdateSourceTrigger=LostFocus}"
                                 MaxLength="2"
                                 Margin="0,4,0,16"/>

                        <!-- Living Children -->
                        <TextBlock Text="Living Children from this Pregnancy"
                                   FontWeight="SemiBold"/>

                        <TextBox Text="{Binding LivingChildrenCount, UpdateSourceTrigger=LostFocus}"
                                 MaxLength="2"
                                 Margin="0,4,0,6"/>

                        <TextBlock Text="Enter the number of children from this pregnancy who are currently living."
                                   FontSize="12"
                                   Opacity="0.65"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Complications"
                                   FontWeight="SemiBold"/>

                        <TextBox Text="{Binding Complications, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="2000"
                                 MinHeight="80"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,4,0,20"/>

                        <Separator Margin="0,4,0,20"/>

                        <!-- Clinical Notes -->
                        <TextBlock Text="Clinical Notes"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="2000"
                                 MinHeight="100"
                                 Padding="10"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,4,0,18"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Foreground="Firebrick"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button Content="Cancel"
                                    Padding="16,8"
                                    Margin="0,0,10,0"
                                    Click="CancelButton_Click"/>

                            <Button Content="Save Changes"
                                    Padding="16,8"
                                    Command="{Binding SaveCommand}"/>

                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
