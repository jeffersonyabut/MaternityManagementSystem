<UserControl x:Class="MaternityManagementSystem.Views.AppointmentSmsReminderMonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MaternityManagementSystem.Views"
             xmlns:models="clr-namespace:MaternityManagementSystem.Models">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#6554C0"/>
        <SolidColorBrush x:Key="PageBrush" Color="#F6F7FB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#25243A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#85849A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#EAEAF1"/>

        <local:DateOnlyDateTimeConverter x:Key="DateOnlyDateTimeConverter"/>
        <local:RegionalDateTimeConverter x:Key="RegionalDateTimeConverter"/>

        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#EAEAF1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="MonitoringDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F0F4"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FAFAFC"/>
            <Setter Property="Foreground" Value="#77768B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EAEAF1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#343348"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F0F0F4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8F7FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28">
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="SMS Reminder Monitoring"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Review locally recorded appointment reminder activity and status."
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,7,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Background="White"
                            Foreground="#6554C0"
                            BorderBrush="#6554C0"
                            BorderThickness="1"
                            Padding="18,8"
                            MinHeight="40"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Cursor="Hand"
                            VerticalAlignment="Center"/>
                </Grid>

                <Border Background="#F0EEFA"
                        BorderBrush="#D9D3F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,16">
                    <TextBlock Text="ProviderAccepted means the SMS provider accepted the request. It does not confirm that the recipient received the message."
                               Foreground="#4B4380"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <ItemsControl ItemsSource="{Binding StatusCounts}"
                              Margin="0,0,0,18">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,10,10"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SummaryCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Count}"
                                               FontSize="25"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}"
                                               Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="White"
                        BorderBrush="#EAEAF1"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4,0,10,12">
                            <TextBlock Text="Patient search"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="38"
                                     Padding="8,6"
                                     ToolTip="Search by patient first name, last name, or patient number"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,10,12">
                            <TextBlock Text="Status"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,5"/>
                            <ComboBox SelectedValuePath="Tag"
                                      SelectedValue="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}"
                                      MinHeight="38"
                                      Padding="6">
                                <ComboBoxItem Content="All statuses" Tag="{x:Null}"/>
                                <ComboBoxItem Content="Pending" Tag="{x:Static models:AppointmentSmsReminderStatus.Pending}"/>
                                <ComboBoxItem Content="Sending" Tag="{x:Static models:AppointmentSmsReminderStatus.Sending}"/>
                                <ComboBoxItem Content="Provider accepted" Tag="{x:Static models:AppointmentSmsReminderStatus.ProviderAccepted}"/>
                                <ComboBoxItem Content="Failed" Tag="{x:Static models:AppointmentSmsReminderStatus.Failed}"/>
                                <ComboBoxItem Content="Unknown" Tag="{x:Static models:AppointmentSmsReminderStatus.Unknown}"/>
                                <ComboBoxItem Content="Superseded" Tag="{x:Static models:AppointmentSmsReminderStatus.Superseded}"/>
                                <ComboBoxItem Content="Skipped" Tag="{x:Static models:AppointmentSmsReminderStatus.Skipped}"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,10,12">
                            <TextBlock Text="Reminder type"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,5"/>
                            <ComboBox SelectedValuePath="Tag"
                                      SelectedValue="{Binding SelectedReminderType, UpdateSourceTrigger=PropertyChanged}"
                                      MinHeight="38"
                                      Padding="6">
                                <ComboBoxItem Content="All types" Tag="{x:Null}"/>
                                <ComboBoxItem Content="Advance 3-day" Tag="{x:Static models:AppointmentSmsReminderType.Advance3Day}"/>
                                <ComboBoxItem Content="Final 24-hour" Tag="{x:Static models:AppointmentSmsReminderType.Final24Hour}"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="4,0,10,12">
                            <TextBlock Text="Appointment from"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding AppointmentDateFrom, Converter={StaticResource DateOnlyDateTimeConverter}, UpdateSourceTrigger=PropertyChanged}"
                                        MinHeight="38"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="4" Margin="4,0,4,12">
                            <TextBlock Text="Appointment to"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding AppointmentDateTo, Converter={StaticResource DateOnlyDateTimeConverter}, UpdateSourceTrigger=PropertyChanged}"
                                        MinHeight="38"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="5"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Clear Filters"
                                    Command="{Binding ClearFiltersCommand}"
                                    Margin="0,0,8,0"
                                    Padding="16,8"
                                    MinHeight="38"/>
                            <Button Content="Apply Filters"
                                    Command="{Binding ApplyFiltersCommand}"
                                    Background="#6554C0"
                                    Foreground="White"
                                    Padding="18,8"
                                    MinHeight="38"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ProgressBar IsIndeterminate="True"
                             Height="4"
                             Margin="0,0,0,8">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <Border Background="#FFF1F0"
                        BorderBrush="#F0C7C3"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#9D3029"
                               TextWrapping="Wrap"/>
                </Border>

                <DataGrid ItemsSource="{Binding Records}"
                          Style="{StaticResource MonitoringDataGridStyle}"
                          Height="360"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="PATIENT" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                            <TextBlock>
                                        <TextBlock.Inlines>
                                            <Run Text="{Binding PatientFirstName}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding PatientLastName}"/>
                                        </TextBlock.Inlines>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PATIENT NO."
                                            Binding="{Binding PatientNumber, TargetNullValue=—}"
                                            Width="120"/>
                        <DataGridTemplateColumn Header="APPOINTMENT" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding AppointmentDate, StringFormat={}{0:dd/MM/yyyy}}"/>
                                        <TextBlock Text="{Binding AppointmentStartTime, StringFormat={}{0:hh:mm tt}}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="REMINDER"
                                            Binding="{Binding ReminderType}"
                                            Width="120"/>
                        <DataGridTextColumn Header="STATUS"
                                            Binding="{Binding Status}"
                                            Width="135"/>
                        <DataGridTextColumn Header="SCHEDULED (LOCAL)"
                                            Binding="{Binding ScheduledAtUtc, Converter={StaticResource RegionalDateTimeConverter}}"
                                            Width="165"/>
                        <DataGridTextColumn Header="CREATED (LOCAL)"
                                            Binding="{Binding CreatedAtUtc, Converter={StaticResource RegionalDateTimeConverter}}"
                                            Width="165"/>
                        <DataGridTextColumn Header="ATTEMPT STARTED (LOCAL)"
                                            Binding="{Binding AttemptStartedAtUtc, Converter={StaticResource RegionalDateTimeConverter}}"
                                            Width="180"/>
                        <DataGridTextColumn Header="STATUS CHANGED (LOCAL)"
                                            Binding="{Binding StatusChangedAtUtc, Converter={StaticResource RegionalDateTimeConverter}}"
                                            Width="185"/>
                        <DataGridTextColumn Header="FINALIZED (LOCAL)"
                                            Binding="{Binding FinalizedAtUtc, Converter={StaticResource RegionalDateTimeConverter}}"
                                            Width="165"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}">
                        <Run Text="Page "/>
                        <Run Text="{Binding CurrentPageNumber}"/>
                        <Run Text=" of "/>
                        <Run Text="{Binding TotalPages}"/>
                        <Run Text="  ·  "/>
                        <Run Text="{Binding TotalRecords}"/>
                        <Run Text=" records"/>
                    </TextBlock>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Previous"
                                Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding HasPreviousPage}"
                                Margin="0,0,8,0"
                                Padding="16,7"/>
                        <Button Content="Next"
                                Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding HasNextPage}"
                                Padding="16,7"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
