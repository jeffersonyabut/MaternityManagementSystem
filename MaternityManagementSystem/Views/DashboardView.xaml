<UserControl x:Class="MaternityManagementSystem.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <TextBlock Text="Dashboard"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#202124"/>

            <TextBlock Text="Welcome to the Maternity Clinic Management System."
                       FontSize="15"
                       Foreground="#666666"
                       Margin="0,8,0,28"/>

            <UniformGrid Columns="2">
                <Border Background="White"
                        CornerRadius="12"
                        Padding="24"
                        Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Patients"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Patient records will go here."
                                   Margin="0,8,0,0"
                                   Foreground="#666666"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="12"
                        Padding="24"
                        Margin="10,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Appointments"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Appointment management will go here."
                                   Margin="0,8,0,0"
                                   Foreground="#666666"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="12"
                        Padding="24"
                        Margin="0,10,10,0">
                    <StackPanel>
                        <TextBlock Text="Maternity Records"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Clinical records will go here."
                                   Margin="0,8,0,0"
                                   Foreground="#666666"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="12"
                        Padding="24"
                        Margin="10,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Staff Management"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Staff accounts and roles will go here."
                                   Margin="0,8,0,0"
                                   Foreground="#666666"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
