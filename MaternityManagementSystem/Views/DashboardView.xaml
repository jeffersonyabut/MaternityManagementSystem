<UserControl x:Class="MaternityManagementSystem.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <SolidColorBrush x:Key="PageBackground" Color="#F5F5FA"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryPurple" Color="#7952B3"/>
        <SolidColorBrush x:Key="MainText" Color="#29243B"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#777184"/>
        <SolidColorBrush x:Key="CardBorder" Color="#EAE7F0"/>

        <Style x:Key="SummaryIconContainerStyle"
               TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource AccentSurface}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="InteractiveCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource CardStyle}">

            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource InteractiveSurfaceHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <Style x:Key="EmptyStateStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="20"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBackground}">

        <!-- Main Dashboard Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="28">

                <!-- Header -->
                <Grid Margin="0,0,0,28">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="GOLDDIE  ·  CLINIC MANAGEMENT"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryAccent}"/>

                        <TextBlock Text="Dashboard"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="Overview of your maternity clinic's activity."
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                    <!-- Header Status -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">

                        <Border Background="{DynamicResource AccentSurface}"
                                CornerRadius="8"
                                Padding="14,8"
                                HorizontalAlignment="Right">

                            <TextBlock Text="OVERVIEW"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryAccent}"/>

                        </Border>

                        <!-- Refresh Indicator -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding IsRefreshing,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">

                            <ProgressBar IsIndeterminate="True"
                                         Width="55"
                                         Height="4"
                                         Foreground="{DynamicResource PrimaryAccent}"
                                         VerticalAlignment="Center"/>

                            <TextBlock Text="Refreshing..."
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#B42318"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding ErrorMessage}"
                                             Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>

                <!-- Summary Cards -->
                <UniformGrid Columns="4"
                             Margin="0,0,0,20">

                    <!-- Total Patients -->
                    <Border Style="{StaticResource InteractiveCardStyle}"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            ToolTip="Open Patient Management"
                            MouseLeftButtonUp="NavigateToPatients">

                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Total Patients"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Center"/>

                                <Border Style="{StaticResource SummaryIconContainerStyle}">
                                    <TextBlock Text="&#xE77B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="{DynamicResource PrimaryAccent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding TotalPatients}"
                                       Style="{StaticResource MetricValueStyle}"
                                       Margin="0,12,0,0"/>

                            <TextBlock Text="Registered patients"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Active Pregnancies -->
                    <Border Style="{StaticResource InteractiveCardStyle}"
                            Margin="5,0"
                            Cursor="Hand"
                            ToolTip="View patient and pregnancy records"
                            MouseLeftButtonUp="NavigateToPatients">

                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Active Pregnancies"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Center"/>

                                <Border Style="{StaticResource SummaryIconContainerStyle}">
                                    <TextBlock Text="&#xE8D4;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="{DynamicResource PrimaryAccent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding ActivePregnancies}"
                                       Style="{StaticResource MetricValueStyle}"
                                       Margin="0,12,0,0"/>

                            <TextBlock Text="Current pregnancy records"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Today's Appointments -->
                    <Border Style="{StaticResource InteractiveCardStyle}"
                            Margin="5,0"
                            Cursor="Hand"
                            ToolTip="Open Appointment Management"
                            MouseLeftButtonUp="NavigateToAppointments">

                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Today's Appointments"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Center"/>

                                <Border Style="{StaticResource SummaryIconContainerStyle}">
                                    <TextBlock Text="&#xE787;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="{DynamicResource PrimaryAccent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding TodaysAppointments}"
                                       Style="{StaticResource MetricValueStyle}"
                                       Margin="0,12,0,0"/>

                            <TextBlock Text="Scheduled and confirmed"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Prenatal Visits -->
                    <Border Style="{StaticResource InteractiveCardStyle}"
                            Margin="10,0,0,0"
                            Cursor="Hand"
                            ToolTip="Open Patient Management to select a pregnancy"
                            MouseLeftButtonUp="NavigateToPrenatalCare">

                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Prenatal Visits"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Center"/>

                                <Border Style="{StaticResource SummaryIconContainerStyle}">
                                    <TextBlock Text="&#xE95E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="{DynamicResource PrimaryAccent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding TotalPrenatalVisits}"
                                       Style="{StaticResource MetricValueStyle}"
                                       Margin="0,12,0,0"/>

                            <TextBlock Text="Recorded clinic visits"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- Charts Row -->
                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Patient Registration Chart -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Margin="0,0,10,0">

                        <StackPanel>
                            <TextBlock Text="Patient Registrations"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="New patient registrations over the last six months"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,5,0,16"/>

                            <Grid Height="250">

                                <lvc:CartesianChart
                                    Series="{Binding RegistrationSeries}"
                                    XAxes="{Binding RegistrationXAxis}"
                                    YAxes="{Binding RegistrationYAxis}">

                                    <lvc:CartesianChart.Style>
                                        <Style TargetType="{x:Type lvc:CartesianChart}">
                                            <Setter Property="Visibility" Value="Visible"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRegistrationData}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </lvc:CartesianChart.Style>

                                </lvc:CartesianChart>

                                <TextBlock Text="No patient registrations recorded during this period.">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource EmptyStateStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRegistrationData}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Prenatal Activity Chart -->
                    <Border Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Margin="10,0,0,0">

                        <StackPanel>
                            <TextBlock Text="Prenatal Activity"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Monthly prenatal visit records"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,5,0,16"/>

                            <Grid Height="250">

                                <lvc:CartesianChart
                                    Series="{Binding PrenatalVisitSeries}"
                                    XAxes="{Binding PrenatalXAxis}"
                                    YAxes="{Binding PrenatalYAxis}">

                                    <lvc:CartesianChart.Style>
                                        <Style TargetType="{x:Type lvc:CartesianChart}">
                                            <Setter Property="Visibility" Value="Visible"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPrenatalVisitData}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </lvc:CartesianChart.Style>

                                </lvc:CartesianChart>


                                <TextBlock Text="No prenatal visits recorded during this period.">
                                
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource EmptyStateStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPrenatalVisitData}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- Appointment Distribution and Upcoming Appointments -->
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.85*"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Appointment Distribution -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Margin="0,0,10,0">

                        <StackPanel>
                            <TextBlock Text="Appointment Distribution"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Overview by appointment status"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,5,0,12"/>

                            <Grid Height="250">

                                <lvc:PieChart
                                    Series="{Binding AppointmentStatusSeries}"
                                    LegendPosition="Bottom">

                                    <lvc:PieChart.Style>
                                        <Style TargetType="{x:Type lvc:PieChart}">
                                            <Setter Property="Visibility" Value="Visible"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAppointmentData}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </lvc:PieChart.Style>

                                </lvc:PieChart>


                                <TextBlock Text="No appointment records available.">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource EmptyStateStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAppointmentData}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Upcoming Appointments -->
                    <Border Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Margin="10,0,0,0">

                        <StackPanel>
                            <TextBlock Text="Upcoming Appointments"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Next scheduled and confirmed appointments"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,5,0,16"/>

                            <Grid MinHeight="180">

                                <DataGrid ItemsSource="{Binding UpcomingAppointments}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          RowHeaderWidth="0"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          MinHeight="180"
                                          MaxHeight="280"
                                          MouseDoubleClick="UpcomingAppointments_MouseDoubleClick">

                                    <DataGrid.Style>
                                        <Style TargetType="{x:Type DataGrid}">
                                            <Setter Property="Visibility" Value="Visible"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUpcomingAppointments}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>

                                    <DataGrid.Resources>

                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                                         Color="#EEE6F7"/>

                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                                         Color="#7952B3"/>

                                        <Style TargetType="{x:Type DataGridRow}"
                                               BasedOn="{StaticResource {x:Type DataGridRow}}">

                                            <Style.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource InteractiveSurfaceHover}"/>
                                                </Trigger>

                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                                                </Trigger>

                                            </Style.Triggers>
                                        </Style>

                                        <Style x:Key="AppointmentStatusBadgeStyle"
                                               TargetType="Border">

                                            <Setter Property="Background" Value="#F0EDF4"/>
                                            <Setter Property="CornerRadius" Value="6"/>
                                            <Setter Property="Padding" Value="7,2"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Status}" Value="Scheduled">
                                                    <Setter Property="Background" Value="#F1EAF8"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                                                    <Setter Property="Background" Value="#E8F1FC"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="Background" Value="#E8F5EC"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter Property="Background" Value="#FCEAEA"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Status}" Value="No-show">
                                                    <Setter Property="Background" Value="#EEEEF0"/>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>

                                        <Style x:Key="AppointmentStatusTextStyle"
                                               TargetType="TextBlock">

                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#7952B3"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                                                    <Setter Property="Foreground" Value="#2864A5"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="Foreground" Value="#287A45"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter Property="Foreground" Value="#B42318"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Status}" Value="No-show">
                                                    <Setter Property="Foreground" Value="#686873"/>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>

                                        <Style TargetType="{x:Type DataGridCell}"
                                               BasedOn="{StaticResource {x:Type DataGridCell}}">

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsSelected,
                                                    RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                             Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>

                                    </DataGrid.Resources>

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Patient"
                                                            Binding="{Binding PatientName}"
                                                            Width="*"/>

                                        <DataGridTextColumn Header="Date"
                                                            Binding="{Binding AppointmentDate}"
                                                            Width="100"/>

                                        <DataGridTextColumn Header="Time"
                                                            Binding="{Binding StartTime}"
                                                            Width="85"/>

                                        <DataGridTemplateColumn Header="Status"
                                                                Width="100">

                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>

                                                    <Border Style="{StaticResource AppointmentStatusBadgeStyle}">
                                                        <TextBlock Text="{Binding Status}"
                                                                   Style="{StaticResource AppointmentStatusTextStyle}"/>
                                                    </Border>

                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>

                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>

                                </DataGrid>

                                <TextBlock Text="No upcoming appointments scheduled.">
                                

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource EmptyStateStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUpcomingAppointments}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>

                        </StackPanel>

                    </Border>

                </Grid>

            </StackPanel>

        </ScrollViewer>

        <!-- Initial Loading Overlay -->
        <Border Panel.ZIndex="10"
                Background="{DynamicResource SurfaceBackground}"
                Visibility="{Binding IsInitialLoading,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="220">

                <ProgressBar IsIndeterminate="True"
                             Width="180"
                             Height="5"
                             Foreground="{DynamicResource PrimaryAccent}"/>

                <TextBlock Text="Loading dashboard..."
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
