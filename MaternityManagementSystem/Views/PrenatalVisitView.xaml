<UserControl x:Class="MaternityManagementSystem.Views.PrenatalVisitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">

                <Button Content="← Back to Patient Profile"
                        Padding="12,7"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"
                        Click="BackButton_Click"/>

                <TextBlock Text="Prenatal Visits"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock Text="View and manage prenatal visit records for this pregnancy."
                           Margin="0,6,0,0"
                           FontSize="14"
                           Opacity="0.7"/>
            </StackPanel>

            <!-- Pregnancy Information -->
            <Border Grid.Row="1"
                    Padding="20"
                    Margin="0,0,0,20"
                    CornerRadius="10"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <TextBlock Text="Selected Pregnancy"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding Pregnancy.Status}"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Margin="0,6,0,0">
                        <Run Text="Last menstrual period: "/>
                        <Run Text="{Binding Pregnancy.LastMenstrualPeriod,
                            TargetNullValue='Not recorded',
                            StringFormat={}{0:MMM dd, yyyy}}"/>
                    </TextBlock>

                    <TextBlock Margin="0,4,0,0">
                        <Run Text="Estimated due date: "/>
                        <Run Text="{Binding Pregnancy.EstimatedDueDate,
                            TargetNullValue='Not recorded',
                            StringFormat={}{0:MMM dd, yyyy}}"/>
                    </TextBlock>

                    <TextBlock Margin="0,4,0,0">
                        <Run Text="Pregnancy end date: "/>
                        <Run Text="{Binding Pregnancy.PregnancyEndDate,
                            TargetNullValue='Not recorded',
                            StringFormat={}{0:MMM dd, yyyy}}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Prenatal Visit History -->
            <Border Grid.Row="2"
                    Padding="24"
                    CornerRadius="10"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <DockPanel Margin="0,0,0,18"
                               LastChildFill="False">

                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Visit History"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Recorded prenatal consultations."
                                       Margin="0,5,0,0"
                                       Opacity="0.7"/>
                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                                Content="+ Add Visit"
                                Padding="14,8"
                                VerticalAlignment="Center"
                                Click="AddVisitButton_Click"/>
                    </DockPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Opacity="0.75"/>

                    <ItemsControl ItemsSource="{Binding Visits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,12">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Visit Information -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding VisitDate,
                                                StringFormat={}{0:MMMM dd, yyyy}}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="{Binding Notes,
                                                TargetNullValue='No notes recorded'}"
                                                       Margin="0,8,0,0"
                                                       TextWrapping="Wrap"
                                                       Opacity="0.75"/>
                                        </StackPanel>

                                        <!-- Visit Actions -->
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Margin="16,0,0,0"
                                                    VerticalAlignment="Top">

                                            <Button Content="Vital Signs"
                                                    Padding="14,7"
                                                    Margin="0,0,8,0"
                                                    Click="VitalSignsButton_Click"/>
                                            
                                            <Button Content="Laboratory Results"
                                                    Padding="14,7"
                                                    Margin="0,0,8,0"
                                                    Click="LaboratoryResultsButton_Click"/>


                                            <Button Content="Generate Visit Report"
                                                    Padding="14,7"
                                                    Margin="0,0,8,0"
                                                    Click="GenerateVisitReportButton_Click"/>
                                            
                                            <Button Content="Edit"
                                                    Padding="14,7"
                                                    Margin="0,0,8,0"
                                                    Click="EditVisitButton_Click"/>

                                            <Button Content="History"
                                                    Padding="14,7"
                                                    Click="VisitHistoryButton_Click"/>

                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
