<UserControl x:Class="MaternityManagementSystem.Views.PrenatalVisitEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">

                <Button Content="← Back to Prenatal Visits"
                        Padding="12,7"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"
                        Click="CancelButton_Click"/>

                <TextBlock Text="Edit Prenatal Visit"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Update the information recorded for this prenatal consultation."
                           Margin="0,6,0,0"
                           FontSize="14"
                           Opacity="0.7"/>
            </StackPanel>

            <!-- Edit Form -->
            <Border Grid.Row="1"
                    Padding="24"
                    CornerRadius="10"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <TextBlock Text="Visit Information"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20"/>

                    <!-- Visit Date -->
                    <TextBlock Text="Visit Date"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <DatePicker SelectedDate="{Binding VisitDate}"
                                IsEnabled="{Binding IsLoaded}"
                                Margin="0,0,0,20"
                                HorizontalAlignment="Stretch"/>

                    <!-- Clinical Notes -->
                    <TextBlock Text="Clinical Notes"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBox Text="{Binding Notes,
                                            UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsLoaded}"
                             MinHeight="140"
                             MaxHeight="240"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="12"
                             Margin="0,0,0,16"/>

                    <!-- Status Message -->
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               Opacity="0.75"/>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Cancel"
                                Padding="16,8"
                                Margin="0,0,10,0"
                                Click="CancelButton_Click"/>

                        <Button Content="Save Changes"
                                Padding="18,8"
                                IsEnabled="{Binding CanSave}"
                                Click="SaveButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
