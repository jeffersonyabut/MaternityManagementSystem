<UserControl x:Class="MaternityManagementSystem.Views.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#6554C0"/>
        <SolidColorBrush x:Key="PageBrush" Color="#F6F7FB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#25243A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#85849A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#EAEAF1"/>

        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BorderBrush" Value="#EAEAF1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#55546A"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E4E3EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#25243A"/>
        </Style>

        <Style x:Key="SectionDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#85849A"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource PageBrush}">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="30">

                <!-- PAGE HEADER -->

                <Grid Margin="0,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="System Settings"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="Configure clinic information and application preferences."
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,7,0,0"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Save Changes"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="22,9"
                            MinHeight="40"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Click="SaveSettingsButton_Click"/>

                </Grid>

                <!-- CLINIC PROFILE -->

                <Border Style="{StaticResource SettingsCardStyle}"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <StackPanel Margin="0,0,0,22">

                            <TextBlock Text="Clinic Profile"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Manage the clinic's identity and contact information."
                                       Style="{StaticResource SectionDescriptionStyle}"/>

                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Clinic Name"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                                         Text="{Binding ClinicName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Enter the clinic name"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Contact Number"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                                         Text="{Binding ClinicContactNumber, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Enter the clinic contact number"/>

                            </StackPanel>

                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Email Address"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                                         Text="{Binding ClinicEmail, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Enter the clinic email address"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Clinic Address"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                                         Text="{Binding ClinicAddress, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Enter the clinic address"/>

                            </StackPanel>

                        </Grid>

                        <StackPanel Margin="0,18,0,0">

                            <TextBlock Text="Clinic Logo Path"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                                     Text="{Binding ClinicLogoPath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Enter the path to the clinic logo image"/>

                            <TextBlock Text="Optional. Used for clinic branding in supported application screens and reports."
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,6,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

                <!-- APPOINTMENT SETTINGS -->

                <Border Style="{StaticResource SettingsCardStyle}"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="Appointment Settings"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="Configure the default scheduling behavior."
                                   Style="{StaticResource SectionDescriptionStyle}"
                                   Margin="0,5,0,20"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Default Appointment Duration (minutes)"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                                         Text="{Binding DefaultAppointmentDuration, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Enter the default appointment duration in minutes"/>

                                <TextBlock Text="Used when creating appointments without a specified duration."
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,6,0,0"/>

                            </StackPanel>
                        </Grid>

                    </StackPanel>

                </Border>

                <!-- NOTIFICATION SETTINGS -->

                <Border Style="{StaticResource SettingsCardStyle}"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="Notification Settings"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="Manage notification preferences for clinic appointments."
                                   Style="{StaticResource SectionDescriptionStyle}"
                                   Margin="0,5,0,20"/>

                        <Border Background="#FAFAFC"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="SMS Notifications"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>

                                    <TextBlock Text="Enable SMS notification functionality."
                                               FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,5,0,0"/>

                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsSmsEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <Border Background="#FAFAFC"
                                CornerRadius="8"
                                Padding="16">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="Appointment Reminders"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>

                                    <TextBlock Text="Allow appointment reminder notifications."
                                               FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,5,0,0"/>

                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding AreAppointmentRemindersEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <TextBlock Text="SMS delivery requires a configured notification provider. Enabling this setting alone does not send messages."
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0"/>

                    </StackPanel>

                </Border>

                <!-- REGIONAL SETTINGS -->

                <Border Style="{StaticResource SettingsCardStyle}"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="Regional Settings"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="Configure the application's regional display preferences."
                                   Style="{StaticResource SectionDescriptionStyle}"
                                   Margin="0,5,0,20"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Time Zone"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                                         Text="{Binding TimeZone, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Enter a Windows time zone ID"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Date Format"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                                         Text="{Binding DateFormat, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Example: dd/MM/yyyy"/>

                            </StackPanel>

                        </Grid>

                        <TextBlock Text="The default time zone is Singapore Standard Time (Philippine Time)."
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,12,0,0"/>

                    </StackPanel>

                </Border>

                <!-- DATABASE BACKUP -->

                <Border Style="{StaticResource SettingsCardStyle}"
                        Margin="0,0,0,18">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Database Backup"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Create and validate a timestamped backup of the clinic database."
                                       Style="{StaticResource SectionDescriptionStyle}"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Backup files contain sensitive clinic records. Store them in an approved secure location."
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="{Binding BackupStatusMessage}"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Create Backup"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="18,9"
                                MinHeight="40"
                                FontWeight="SemiBold"
                                FontSize="12"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Click="CreateDatabaseBackupButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCreatingBackup}"
                                                     Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                    </Grid>

                </Border>

                <!-- FOOTER -->

                <Border Background="White"
                        CornerRadius="10"
                        BorderBrush="#EAEAF1"
                        BorderThickness="1"
                        Padding="18,14">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Changes are recorded in the system audit log."
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusMessage}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>

                    </Grid>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
