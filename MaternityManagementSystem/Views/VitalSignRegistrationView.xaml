<UserControl x:Class="MaternityManagementSystem.Views.VitalSignRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">

                <Button Content="← Back to Vital Signs"
                        Padding="12,7"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"
                        Click="CancelButton_Click"/>

                <TextBlock Text="Record Vital Signs"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Enter the patient's measurements for this prenatal visit."
                           Margin="0,6,0,0"
                           FontSize="14"
                           Opacity="0.7"/>
            </StackPanel>

            <!-- Registration Form -->
            <Border Grid.Row="1"
                    Padding="24"
                    CornerRadius="10"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>

                    <!-- Blood Pressure -->
                    <TextBlock Text="Blood Pressure"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,10,0">

                            <TextBlock Text="Systolic (mmHg)"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBox Text="{Binding SystolicBloodPressureInput,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">

                            <TextBlock Text="Diastolic (mmHg)"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBox Text="{Binding DiastolicBloodPressureInput,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"/>
                        </StackPanel>
                    </Grid>

                    <!-- Other Measurements -->
                    <TextBlock Text="Other Measurements"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <!-- Heart Rate and Respiratory Rate -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,10,0">

                            <TextBlock Text="Heart Rate (bpm)"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBox Text="{Binding HeartRateInput,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">

                            <TextBlock Text="Respiratory Rate (breaths/min)"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBox Text="{Binding RespiratoryRateInput,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"/>
                        </StackPanel>
                    </Grid>

                    <!-- Temperature and Oxygen Saturation -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,10,0">

                            <TextBlock Text="Temperature (°C)"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBox Text="{Binding TemperatureCelsiusInput,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">

                            <TextBlock Text="Oxygen Saturation (%)"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBox Text="{Binding OxygenSaturationInput,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"/>
                        </StackPanel>
                    </Grid>

                    <!-- Weight and Fetal Heart Rate -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,10,0">

                            <TextBlock Text="Weight (kg)"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBox Text="{Binding WeightKgInput,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">

                            <TextBlock Text="Fetal Heart Rate (bpm)"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBox Text="{Binding FetalHeartRateInput,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"/>
                        </StackPanel>
                    </Grid>

                    <!-- Recording Timestamp -->
                    <TextBlock Text="Recording Time"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Automatically recorded when this form is opened."
                               Margin="0,0,0,24"
                               Opacity="0.7"/>

                    <!-- Clinical Notes -->
                    <TextBlock Text="Clinical Notes"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBox Text="{Binding Notes,
                                            UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="120"
                             MaxHeight="220"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="12"
                             Margin="0,0,0,16"/>

                    <!-- Status Message -->
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               Opacity="0.75"/>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Cancel"
                                Padding="16,8"
                                Margin="0,0,10,0"
                                Click="CancelButton_Click"/>

                        <Button Content="Save Vital Signs"
                                Padding="18,8"
                                IsEnabled="{Binding CanSave}"
                                Click="SaveButton_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
