<UserControl x:Class="MaternityManagementSystem.Views.PatientListView"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="600"
             Background="Transparent"
             xmlns:converters="clr-namespace:MaternityManagementSystem.Converters">
    <UserControl.Resources>
        <converters:RegionalDateOnlyConverter
        x:Key="RegionalDateOnlyConverter"/>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Patients"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Search and view registered patient records."
                       FontSize="14"
                       Opacity="0.7"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Search -->
        <Border Grid.Row="1"
                Padding="16"
                Margin="0,0,0,16"
                CornerRadius="10"
                Background="{DynamicResource MaterialDesignPaper}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Padding="10"
                         VerticalContentAlignment="Center"
                         materialDesign:HintAssist.Hint="Search patient number, name, or contact"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Column="2"
                        Content="Search"
                        Command="{Binding SearchPatientsCommand}"
                        Padding="20,10"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </Grid>
        </Border>


        <!-- Patient table and pagination -->
        <Border Grid.Row="2"
        Padding="12"
        CornerRadius="10"
        Background="{DynamicResource MaterialDesignPaper}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Patients}"
                  SelectedItem="{Binding SelectedPatient}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Patient No."
                                    Binding="{Binding PatientNumber}"
                                    Width="150"/>

                        <DataGridTextColumn Header="First Name"
                                    Binding="{Binding FirstName}"
                                    Width="*"/>

                        <DataGridTextColumn Header="Middle Name"
                                    Binding="{Binding MiddleName}"
                                    Width="*"/>

                        <DataGridTextColumn Header="Last Name"
                                    Binding="{Binding LastName}"
                                    Width="*"/>

                        <DataGridTextColumn Header="Date of Birth"
                                    Binding="{Binding DateOfBirth,
                                        Converter={StaticResource RegionalDateOnlyConverter}}"
                                    Width="140"/>

                        <DataGridTextColumn Header="Contact Number"
                                    Binding="{Binding ContactNumber}"
                                    Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination -->
                <Grid Grid.Row="1" Margin="4,12,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Opacity="0.8"
                       Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <Button Content="Open Profile"
                        Command="{Binding OpenProfileCommand}"
                        IsEnabled="{Binding HasSelectedPatient}"
                        Padding="12,7"
                        Margin="0,0,12,0"/>

                        <Button Content="Previous"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoToPreviousPage}"
                        Padding="12,7"
                        Margin="0,0,8,0"/>

                        <TextBlock VerticalAlignment="Center"
                           Margin="4,0,12,0">
                            <Run Text="Page "/>
                            <Run Text="{Binding CurrentPage}"/>
                            <Run Text=" of "/>
                            <Run Text="{Binding TotalPages}"/>
                        </TextBlock>

                        <Button Content="Next"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoToNextPage}"
                        Padding="12,7"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>



    </Grid>
</UserControl>
