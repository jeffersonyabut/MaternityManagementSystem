<UserControl x:Class="MaternityManagementSystem.Views.LaboratoryResultEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <StackPanel>

                <!-- Header -->
                <StackPanel Margin="0,0,0,24">
                    <Button Content="← Cancel"
                            Padding="12,7"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,20"
                            Click="CancelButton_Click"/>

                    <TextBlock Text="Edit Laboratory Result"
                               FontSize="28"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Update the recorded laboratory findings."
                               Margin="0,6,0,0"
                               FontSize="14"
                               Opacity="0.7"/>
                </StackPanel>

                <Border Padding="24"
                        CornerRadius="10"
                        Background="{DynamicResource MaterialDesignPaper}">

                    <StackPanel>

                        <!-- Patient Information -->
                        <TextBlock Text="Patient Information"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Selected Patient"
                                   Opacity="0.7"/>

                        <TextBlock Text="{Binding PatientName}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,20"/>

                        <TextBlock Text="Associated Prenatal Visit"
                                   Opacity="0.7"/>

                        <TextBlock Text="{Binding PrenatalVisitDisplay}"
                                   FontSize="14"
                                   Margin="0,4,0,20"/>

                        <Separator Margin="0,0,0,20"/>

                        <!-- Laboratory Information -->
                        <TextBlock Text="Laboratory Information"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Test Name"/>

                        <TextBox Text="{Binding TestName, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="150"
                                 Margin="0,4,0,20"/>

                        <TextBlock Text="Status"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayText"
                                  MinHeight="36"
                                  Margin="0,4,0,20"/>
                        <TextBlock Text="{Binding StatusHelpText}"
                                   FontSize="13"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Margin="0,-14,0,20"/>

                        <TextBlock Text="{Binding RequestedDateLabel}"/>
                        <DatePicker SelectedDate="{Binding RequestedDate, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,4,0,20"/>
                        <TextBlock Text="{Binding RequestedDateHelpText}"
                                   FontSize="13"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Margin="0,-14,0,20"/>

                        <TextBlock Text="Test Date (required for Awaiting Result and Resulted)"/>

                        <DatePicker SelectedDate="{Binding TestDate, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsTestDateEnabled}"
                                    Margin="0,4,0,20"/>
                        <TextBlock Text="Leave blank until the test has been performed."
                                   FontSize="13"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Margin="0,-14,0,20"/>

                        <Separator Margin="0,4,0,20"/>

                        <!-- Result Details -->
                        <TextBlock Text="Result Details"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="Enter the laboratory findings as stated in the laboratory report."
                                   FontSize="13"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="A result is required only when the status is Resulted."
                                   FontSize="13"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Margin="0,-14,0,20"/>

                        <TextBlock Text="Result"/>

                        <TextBox Text="{Binding Result, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="2000"
                                 IsEnabled="{Binding IsResultEnabled}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,4,0,20"/>

                        <TextBlock Text="Unit (Optional)"/>

                        <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="50"
                                 Margin="0,4,0,20"/>

                        <TextBlock Text="Reference Range (Optional)"/>

                        <TextBox Text="{Binding ReferenceRange, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200"
                                 Margin="0,4,0,20"/>

                        <Separator Margin="0,4,0,20"/>

                        <!-- Notes -->
                        <TextBlock Text="Clinical Notes"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="2000"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,4,0,20"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"
                                   Opacity="0.8"/>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button Content="Cancel"
                                    Padding="18,10"
                                    Margin="0,0,12,0"
                                    Click="CancelButton_Click"/>

                            <Button Content="Save Changes"
                                    Padding="18,10"
                                    Command="{Binding SaveCommand}"/>

                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
