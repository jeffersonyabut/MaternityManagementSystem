<UserControl x:Class="MaternityManagementSystem.Views.VitalSignsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaternityManagementSystem.Converters"
             Background="Transparent">

    <UserControl.Resources>
    <converters:UtcToLocalDateTimeConverter
        x:Key="UtcToLocalDateTimeConverter"/>
</UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">

                <Button Content="← Back to Prenatal Visits"
                        Padding="12,7"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"
                        Click="BackButton_Click"/>

                <TextBlock Text="Vital Signs"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock Text="View and manage measurements recorded during this prenatal visit."
                           Margin="0,6,0,0"
                           FontSize="14"
                           Opacity="0.7"/>
            </StackPanel>

            <!-- Visit Information -->
            <Border Grid.Row="1"
                    Padding="20"
                    Margin="0,0,0,20"
                    CornerRadius="10"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <TextBlock Text="Selected Prenatal Visit"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding PrenatalVisit.VisitDate,
                        StringFormat={}{0:MMMM dd, yyyy}}"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding PrenatalVisit.Notes,
                        TargetNullValue='No notes recorded'}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.7"/>
                </StackPanel>
            </Border>

            <!-- Vital Signs History -->
            <Border Grid.Row="2"
                    Padding="24"
                    CornerRadius="10"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <DockPanel Margin="0,0,0,18"
                               LastChildFill="False">

                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Measurement History"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Vital signs recorded for this visit."
                                       Margin="0,5,0,0"
                                       Opacity="0.7"/>
                        </StackPanel>
                        
                        <Button DockPanel.Dock="Right"
                                Content="+ Record Vital Signs"
                                Padding="14,8"
                                VerticalAlignment="Center"
                                Click="RecordVitalSignsButton_Click"/>
                    </DockPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Opacity="0.75"/>

                    <ItemsControl ItemsSource="{Binding VitalSigns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,12">

                                    <StackPanel>
                                        <TextBlock Text="{Binding RecordedAtUtc,
                                                  Converter={StaticResource UtcToLocalDateTimeConverter},
                                                  StringFormat={}{0:MMM dd, yyyy hh:mm tt}}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>

                                        <WrapPanel Margin="0,10,0,0">

                                            <TextBlock Text="{Binding SystolicBloodPressure,
                                                TargetNullValue='—'}"/>
                                            <TextBlock Text=" / "/>
                                            <TextBlock Text="{Binding DiastolicBloodPressure,
                                                TargetNullValue='—'}"/>
                                            <TextBlock Text=" mmHg"
                                                       Margin="0,0,16,0"/>

                                            <TextBlock Text="HR: "/>
                                            <TextBlock Text="{Binding HeartRate,
                                                TargetNullValue='—'}"/>
                                            <TextBlock Text=" bpm"
                                                       Margin="0,0,16,0"/>

                                            <TextBlock Text="RR: "/>
                                            <TextBlock Text="{Binding RespiratoryRate,
                                                TargetNullValue='—'}"/>
                                            <TextBlock Text=" breaths/min"
                                                       Margin="0,0,16,0"/>

                                            <TextBlock Text="Temp: "/>
                                            <TextBlock Text="{Binding TemperatureCelsius,
                                                TargetNullValue='—'}"/>
                                            <TextBlock Text=" °C"
                                                       Margin="0,0,16,0"/>

                                            <TextBlock Text="SpO₂: "/>
                                            <TextBlock Text="{Binding OxygenSaturation,
                                                TargetNullValue='—'}"/>
                                            <TextBlock Text=" %"
                                                       Margin="0,0,16,0"/>

                                            <TextBlock Text="Weight: "/>
                                            <TextBlock Text="{Binding WeightKg,
                                                TargetNullValue='—'}"/>
                                            <TextBlock Text=" kg"
                                                       Margin="0,0,16,0"/>

                                            <TextBlock Text="FHR: "/>
                                            <TextBlock Text="{Binding FetalHeartRate,
                                                TargetNullValue='—'}"/>
                                            <TextBlock Text=" bpm"/>
                                        </WrapPanel>
                                        
                                        <TextBlock Text="{Binding Notes,
                                                TargetNullValue='No notes recorded'}"
                                                Margin="0,10,0,12"
                                                TextWrapping="Wrap"
                                                Opacity="0.7"/>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right">

                                            <Button Content="History"
                                                    Padding="14,6"
                                                    Margin="0,0,8,0"
                                                    Click="VitalSignHistoryButton_Click"/>

                                            <Button Content="Edit"
                                                    Padding="14,6"
                                                    Margin="0,0,8,0"
                                                    Click="EditVitalSignButton_Click"/>

                                            <Button Content="Archive"
                                                    Padding="14,6"
                                                    Click="ArchiveVitalSignButton_Click"/>

                                        </StackPanel>


                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
