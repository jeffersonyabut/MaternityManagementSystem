<UserControl x:Class="MaternityManagementSystem.Views.PatientRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="600"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page heading -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Register Patient"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Create a new patient record in Golddie."
                           FontSize="14"
                           Opacity="0.7"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Personal information -->
            <Border Grid.Row="1"
                    Padding="22"
                    Margin="0,0,0,18"
                    CornerRadius="12"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <TextBlock Text="Personal Information"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0"
                                 Grid.Column="0"
                                 Margin="0,0,0,16"
                                 Padding="10"
                                 materialDesign:HintAssist.Hint="First name *"
                                 Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBox Grid.Row="0"
                                 Grid.Column="2"
                                 Margin="0,0,0,16"
                                 Padding="10"
                                 materialDesign:HintAssist.Hint="Last name *"
                                 Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBox Grid.Row="1"
                                 Grid.Column="0"
                                 Margin="0,0,0,16"
                                 Padding="10"
                                 materialDesign:HintAssist.Hint="Middle name (optional)"
                                 Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"/>

                        <DatePicker Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="0,0,0,16"
                                    Padding="8"
                                    SelectedDate="{Binding DateOfBirth, UpdateSourceTrigger=PropertyChanged}"
                                    materialDesign:HintAssist.Hint="Date of birth"/>

                        <ComboBox Grid.Row="2"
                                  Grid.Column="0"
                                  Margin="0,0,0,4"
                                  Padding="10"
                                  materialDesign:HintAssist.Hint="Sex"
                                  SelectedItem="{Binding Sex, UpdateSourceTrigger=PropertyChanged}">
                            <sys:String>Female</sys:String>
                            <sys:String>Male</sys:String>
                            <sys:String>Prefer not to say</sys:String>
                        </ComboBox>

                        <ComboBox Grid.Row="2"
                                  Grid.Column="2"
                                  Margin="0,0,0,4"
                                  Padding="10"
                                  materialDesign:HintAssist.Hint="Civil status"
                                  SelectedItem="{Binding CivilStatus, UpdateSourceTrigger=PropertyChanged}">
                            <sys:String>Single</sys:String>
                            <sys:String>Married</sys:String>
                            <sys:String>Widowed</sys:String>
                            <sys:String>Separated</sys:String>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Contact information -->
            <Border Grid.Row="2"
                    Padding="22"
                    Margin="0,0,0,18"
                    CornerRadius="12"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <TextBlock Text="Contact Information"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Margin="0,0,0,16"
                                 Padding="10"
                                 materialDesign:HintAssist.Hint="Contact number"
                                 Text="{Binding ContactNumber, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBox Grid.Column="2"
                                 Margin="0,0,0,16"
                                 Padding="10"
                                 materialDesign:HintAssist.Hint="Email address"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBox Padding="10"
                             MinHeight="80"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             materialDesign:HintAssist.Hint="Home address"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>

                    <Border Padding="14"
                            Margin="0,16,0,0"
                            CornerRadius="8"
                            Background="{DynamicResource MaterialDesignCardBackground}">

                        <StackPanel>
                            <CheckBox IsChecked="{Binding HasSmsReminderConsent, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalContentAlignment="Center">
                                <TextBlock Text="I agree to receive SMS notifications from Goldenstate Maternity Clinic about my upcoming appointments."
                                           TextWrapping="Wrap"/>
                            </CheckBox>

                            <TextBlock Text="Optional. Leave unchecked to decline. Consent can be withdrawn at any time."
                                       Margin="28,6,0,0"
                                       FontSize="12"
                                       Opacity="0.7"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                    </Border>
                </StackPanel>
            </Border>

            <!-- Emergency contact -->
            <Border Grid.Row="3"
                    Padding="22"
                    CornerRadius="12"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <TextBlock Text="Emergency Contact"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Margin="0,0,0,18"
                                 Padding="10"
                                 materialDesign:HintAssist.Hint="Contact person's name"
                                 Text="{Binding EmergencyContactName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBox Grid.Column="2"
                                 Margin="0,0,0,18"
                                 Padding="10"
                                 materialDesign:HintAssist.Hint="Emergency contact number"
                                 Text="{Binding EmergencyContactNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Text="Fields marked with * are required."
                               FontSize="12"
                               Opacity="0.7"
                               Margin="0,0,0,8"/>

                    <Border Padding="10"
                            Margin="0,0,0,16"
                            CornerRadius="6"
                            Background="{DynamicResource MaterialDesignCardBackground}">

                        <TextBlock Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   FontSize="13"/>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Clear Form"
                                Command="{Binding ClearFormCommand}"
                                Padding="18,10"
                                Margin="0,0,10,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>

                        <Button Content="Register Patient"
                                Command="{Binding RegisterPatientCommand}"
                                Padding="18,10"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
