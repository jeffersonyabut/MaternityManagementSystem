<UserControl x:Class="MaternityManagementSystem.Views.AppointmentRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="600"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Heading -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Schedule Appointment"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Create an appointment for a registered patient."
                           FontSize="14"
                           Opacity="0.7"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Patient selection -->
            <Border Grid.Row="1"
                    Padding="22"
                    Margin="0,0,0,18"
                    CornerRadius="12"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <TextBlock Text="Patient Information"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18"/>

                    <!-- Live patient search -->
                    <TextBox x:Name="PatientSearchBox"
                             Padding="10"
                             Margin="0,0,0,12"
                             materialDesign:HintAssist.Hint="Search patient number, name, or contact number"
                             Text="{Binding PatientSearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Patient list -->
                    <DataGrid x:Name="PatientDataGrid"
                              ItemsSource="{Binding Patients}"
                              SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                              SelectionChanged="PatientDataGrid_SelectionChanged"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MinHeight="190"
                              MaxHeight="190"
                              Height="190"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Patient Number"
                                                Binding="{Binding PatientNumber}"
                                                Width="1.2*"/>

                            <DataGridTextColumn Header="First Name"
                                                Binding="{Binding FirstName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Middle Name"
                                                Binding="{Binding MiddleName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Last Name"
                                                Binding="{Binding LastName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Contact Number"
                                                Binding="{Binding ContactNumber}"
                                                Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Patient loading and result information -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Opacity="0.7"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding IsLoadingPatientOptions, StringFormat='Loading patients...'}"
                                   FontSize="12"
                                   Opacity="0.7"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Patient pagination -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.7"
                                   Text="{Binding PatientTotalResults, StringFormat='Total patients: {0}'}"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button Content="Previous"
                                    Padding="12,6"
                                    Margin="0,0,8,0"
                                    Command="{Binding PreviousPatientPageCommand}"
                                    IsEnabled="{Binding CanGoToPreviousPatientPage}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>

                            <TextBlock VerticalAlignment="Center"
                                       Margin="4,0,12,0"
                                       Text="{Binding PatientCurrentPage, StringFormat='Page {0}'}"/>

                            <Button Content="Next"
                                    Padding="12,6"
                                    Command="{Binding NextPatientPageCommand}"
                                    IsEnabled="{Binding CanGoToNextPatientPage}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Selected patient -->
                    <Border Padding="12"
                            Margin="0,0,0,16"
                            CornerRadius="6"
                            Background="{DynamicResource MaterialDesignCardBackground}">

                        <StackPanel>
                            <TextBlock Text="Selected Patient"
                                       FontSize="12"
                                       Opacity="0.65"/>

                            <TextBlock FontWeight="SemiBold"
                                       Margin="0,4,0,0">
                                <Run Text="{Binding SelectedPatient.PatientNumber}"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding SelectedPatient.FirstName}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SelectedPatient.LastName}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Pregnancy selection -->
                    <ComboBox ItemsSource="{Binding Pregnancies}"
                              SelectedItem="{Binding SelectedPregnancy, Mode=TwoWay}"
                              Padding="10"
                              IsEditable="False"
                              IsEnabled="{Binding HasSelectedPatient}"
                              materialDesign:HintAssist.Hint="Pregnancy (optional)">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Status}"
                                               FontWeight="SemiBold"/>

                                    <TextBlock FontSize="12"
                                               Opacity="0.65">
                                        <Run Text="EDD: "/>
                                        <Run Text="{Binding EstimatedDueDate}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Select a patient first to load their pregnancy records."
                               FontSize="12"
                               Opacity="0.65"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Schedule information -->
            <Border Grid.Row="2"
                    Padding="22"
                    Margin="0,0,0,18"
                    CornerRadius="12"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <TextBlock Text="Appointment Schedule"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DatePicker x:Name="AppointmentDatePicker"
                                    Grid.Row="0"
                                    Grid.ColumnSpan="3"
                                    Padding="8"
                                    Margin="0,0,0,18"
                                    materialDesign:HintAssist.Hint="Appointment date *"/>

                        <TextBox x:Name="StartTimeBox"
                                 Grid.Row="1"
                                 Grid.Column="0"
                                 Padding="10"
                                 materialDesign:HintAssist.Hint="Start time * (e.g. 08:30 AM)"/>

                        <TextBox x:Name="EndTimeBox"
                                 Grid.Row="1"
                                 Grid.Column="2"
                                 Padding="10"
                                 materialDesign:HintAssist.Hint="End time (optional)"/>
                    </Grid>

                    <TextBlock Text="If no end time is provided, the appointment will use a 30-minute duration."
                               FontSize="12"
                               Opacity="0.65"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Appointment details -->
            <Border Grid.Row="3"
                    Padding="22"
                    CornerRadius="12"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <TextBlock Text="Appointment Details"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18"/>

                    <TextBox x:Name="PurposeBox"
                             Padding="10"
                             Margin="0,0,0,16"
                             materialDesign:HintAssist.Hint="Appointment purpose *"/>

                    <TextBox x:Name="NotesBox"
                             Padding="10"
                             MinHeight="100"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             materialDesign:HintAssist.Hint="Additional notes (optional)"/>

                    <TextBlock Text="Fields marked with * are required."
                               FontSize="12"
                               Opacity="0.7"
                               Margin="0,18,0,8"/>

                    <Border Padding="10"
                            Margin="0,0,0,16"
                            CornerRadius="6"
                            Background="{DynamicResource MaterialDesignCardBackground}">

                        <TextBlock Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   FontSize="13"/>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Cancel"
                                Padding="18,10"
                                Margin="0,0,10,0"
                                Click="CancelRegistration_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>

                        <Button Content="Clear Form"
                                Padding="18,10"
                                Margin="0,0,10,0"
                                Click="ClearForm_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>

                        <Button Content="Schedule Appointment"
                                Padding="18,10"
                                Click="ScheduleAppointment_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
