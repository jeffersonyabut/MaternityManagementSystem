<UserControl x:Class="MaternityManagementSystem.Views.PatientEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Edit Patient"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock Text="{Binding StatusMessage}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Opacity="0.75"/>
            </StackPanel>

            <!-- Edit form -->
            <Border Grid.Row="1"
                    Padding="24"
                    CornerRadius="10"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <TextBlock Text="Personal Information"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Text="First Name *"/>
                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="100"
                                     Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,12">
                            <TextBlock Text="Middle Name"/>
                            <TextBox Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="100"
                                     Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Last Name *"/>
                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             Margin="0,4,0,16"/>

                    <TextBlock Text="Date of Birth"/>

                    <DatePicker SelectedDate="{Binding DateOfBirthForPicker, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,4,0,16"/>


                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Sex"/>
                            <ComboBox SelectedValue="{Binding Sex, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Content"
                                      Margin="0,4,0,0">
                                <ComboBoxItem Content="Female"/>
                                <ComboBoxItem Content="Male"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Civil Status"/>
                            <ComboBox SelectedValue="{Binding CivilStatus, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Content"
                                      Margin="0,4,0,0">
                                <ComboBoxItem Content="Single"/>
                                <ComboBoxItem Content="Married"/>
                                <ComboBoxItem Content="Widowed"/>
                                <ComboBoxItem Content="Separated"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,0,0,24"/>

                    <TextBlock Text="Contact Information"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Contact Number"/>
                    <TextBox Text="{Binding ContactNumber, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="30"
                             Margin="0,4,0,16"/>

                    <TextBlock Text="Email"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="254"
                             Margin="0,4,0,16"/>

                    <TextBlock Text="Address"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="500"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="64"
                             Margin="0,4,0,24"/>

                    <Separator Margin="0,0,0,24"/>

                    <TextBlock Text="Emergency Contact"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Contact Name"/>
                    <TextBox Text="{Binding EmergencyContactName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="200"
                             Margin="0,4,0,16"/>

                    <TextBlock Text="Contact Number"/>
                    <TextBox Text="{Binding EmergencyContactNumber, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="30"
                             Margin="0,4,0,24"/>


                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Cancel"
                                Padding="18,10"
                                Margin="0,0,12,0"
                                Click="CancelButton_Click"/>

                        <Button Content="Save Changes"
                                Command="{Binding SaveChangesCommand}"
                                Padding="18,10"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="Fields marked with * are required."
                       Margin="4,12,0,0"
                       Opacity="0.65"/>
        </Grid>
    </ScrollViewer>
</UserControl>
