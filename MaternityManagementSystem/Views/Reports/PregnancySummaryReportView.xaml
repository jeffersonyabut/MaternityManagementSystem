<UserControl x:Class="MaternityManagementSystem.Views.Reports.PregnancySummaryReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <UserControl.Resources>
        <BooleanToVisibilityConverter
        x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Background="#F5F5FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">

                <!-- Header -->
                <StackPanel Margin="0,0,0,24">
                    <Button Content="← Back to Reports"
                            HorizontalAlignment="Left"
                            Padding="12,6"
                            Margin="0,0,0,16"
                            Click="BackButton_Click"/>

                    <TextBlock Text="GOLDDIE · CLINIC MANAGEMENT"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#7952B3"/>

                    <TextBlock Text="Pregnancy Summary Report"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#29243B"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="Review pregnancy records, outcomes, and obstetric information."
                               FontSize="13"
                               Foreground="#777184"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Filters -->
                <Border Background="White"
                        BorderBrush="#EAE7F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,20">

                    <StackPanel>
                        <TextBlock Text="Report Filters"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#29243B"
                                   Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Start Date -->
                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,10,14">

                                <TextBlock Text="LMP Start Date"
                                           FontSize="12"
                                           Foreground="#777184"
                                           Margin="0,0,0,6"/>

                                <DatePicker SelectedDate="{Binding StartDate,
                                                                  Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- End Date -->
                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="10,0,0,14">

                                <TextBlock Text="LMP End Date"
                                           FontSize="12"
                                           Foreground="#777184"
                                           Margin="0,0,0,6"/>

                                <DatePicker SelectedDate="{Binding EndDate,
                                                                  Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Patient Search -->
                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,10,0">

                                <TextBlock Text="Patient Search"
                                           FontSize="12"
                                           Foreground="#777184"
                                           Margin="0,0,0,6"/>

                                <TextBox Text="{Binding SearchTerm,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,7"
                                         FontSize="13"
                                         ToolTip="Search by patient name or patient number"/>
                            </StackPanel>

                            <!-- Status -->
                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="10,0,0,0">

                                <TextBlock Text="Pregnancy Status"
                                           FontSize="12"
                                           Foreground="#777184"
                                           Margin="0,0,0,6"/>

                                <ComboBox ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding Status,
                                                                  Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"
                                          Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Filter Actions -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,18,0,0">

                            <Button Content="Clear Filters"
                                    Padding="16,9"
                                    Margin="0,0,10,0"
                                    Command="{Binding ClearFiltersCommand}"/>

                            <Button Content="Generate Report"
                                    Padding="18,9"
                                    Background="#7952B3"
                                    Foreground="White"
                                    Command="{Binding GenerateReportCommand}"
                                    IsEnabled="{Binding IsNotLoading}"/>
                        </StackPanel>

                        <!-- Loading -->
                        <TextBlock Text="Generating report..."
                                   Foreground="#7952B3"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding IsLoading,
                                                        Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Error -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#C62828"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Report Preview -->
                <Border Background="White"
                        BorderBrush="#EAE7F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Report Preview"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#29243B"/>

                                <TextBlock Text="Pregnancy records matching your selected filters."
                                           FontSize="12"
                                           Foreground="#777184"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Print Preview"
                                    Padding="16,9"
                                    Background="#7952B3"
                                    Foreground="White"
                                    IsEnabled="{Binding HasPregnancies}"
                                    Click="PrintPreviewButton_Click"/>
                        </Grid>

                        <!-- Summary -->
                        <Border Background="#F7F3FC"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,16"
                                Visibility="{Binding HasGeneratedReport,
                                                     Converter={StaticResource BooleanToVisibilityConverter}}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Total Pregnancies"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding TotalPregnancies}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#7952B3"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Unique Patients"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding UniquePatientCount}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#7952B3"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Empty State -->
                        <Border Background="#FAFAFC"
                                CornerRadius="8"
                                Padding="24"
                                Visibility="{Binding HasNoPregnancies,
                                                     Converter={StaticResource BooleanToVisibilityConverter}}">

                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No pregnancy records found."
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#777184"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Try adjusting your filters and generate the report again."
                                           FontSize="12"
                                           Foreground="#9993A3"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Pregnancy Records -->
                        <DataGrid ItemsSource="{Binding Report.Pregnancies}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  MinHeight="200"
                                  MaxHeight="500"
                                  Visibility="{Binding HasPregnancies,
                                                       Converter={StaticResource BooleanToVisibilityConverter}}">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Patient No."
                                                    Binding="{Binding Patient.PatientNumber}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Patient Name"
                                                    Width="220">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0} {1} {2}">
                                            <Binding Path="Patient.FirstName"/>
                                            <Binding Path="Patient.MiddleName"/>
                                            <Binding Path="Patient.LastName"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding Status}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="LMP"
                                                    Binding="{Binding LastMenstrualPeriod}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="EDD"
                                                    Binding="{Binding EstimatedDueDate}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Outcome"
                                                    Binding="{Binding PregnancyOutcome}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Delivery Method"
                                                    Binding="{Binding DeliveryMethod}"
                                                    Width="130"/>

                                <DataGridTextColumn Header="Infants"
                                                    Binding="{Binding NumberOfInfants}"
                                                    Width="75"/>

                                <DataGridTextColumn Header="Living Children"
                                                    Binding="{Binding LivingChildrenCount}"
                                                    Width="110"/>

                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Generated Date -->
                        <TextBlock Text="{Binding Report.GeneratedAtUtc,
                                                  StringFormat='Generated: {0:MMM dd, yyyy hh:mm tt} UTC'}"
                                   FontSize="11"
                                   Foreground="#9993A3"
                                   HorizontalAlignment="Right"
                                   Margin="0,14,0,0"
                                   Visibility="{Binding HasGeneratedReport,
                                                        Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
