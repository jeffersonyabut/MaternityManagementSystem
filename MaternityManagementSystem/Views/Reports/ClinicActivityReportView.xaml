<UserControl x:Class="MaternityManagementSystem.Views.Reports.ClinicActivityReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#F5F5FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ReportLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555064"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EAE7F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#777184"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#29243B"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28">

            <!-- Navigation -->
            <Button Content="← Back to Reports"
                    HorizontalAlignment="Left"
                    Padding="12,7"
                    Margin="0,0,0,24"
                    Click="BackButton_Click"/>

            <!-- Header -->
            <TextBlock Text="GOLDDIE · CLINIC MANAGEMENT"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#7952B3"/>

            <TextBlock Text="Clinic Activity Report"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#29243B"
                       Margin="0,5,0,0"/>

            <TextBlock Text="A consolidated overview of patient registrations and clinic operations."
                       FontSize="13"
                       Foreground="#777184"
                       Margin="0,5,0,24"/>

            <!-- Report Configuration -->
            <Border Background="White"
                    BorderBrush="#EAE7F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Report Configuration"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#29243B"/>

                    <TextBlock Text="Select an optional date range to review clinic activity. Leave both dates empty to include all recorded activity."
                               FontSize="13"
                               Foreground="#777184"
                               TextWrapping="Wrap"
                               Margin="0,7,0,22"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Activity Date · From"
                                       Style="{StaticResource ReportLabelStyle}"/>

                            <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,16"
                                        MinHeight="38"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Activity Date · To"
                                       Style="{StaticResource ReportLabelStyle}"/>

                            <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,16"
                                        MinHeight="38"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Clear Filters"
                                Command="{Binding ClearFiltersCommand}"
                                Padding="18,10"
                                Margin="0,0,10,0"/>

                        <Button Content="Generate Report"
                                Command="{Binding GenerateReportCommand}"
                                Padding="18,10"
                                Background="#7952B3"
                                Foreground="White"
                                IsEnabled="{Binding IsNotLoading}"/>

                    </StackPanel>

                    <TextBlock Text="Generating report..."
                               Foreground="#7952B3"
                               FontSize="12"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Right"
                               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#C62828"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                </StackPanel>
            </Border>

            <!-- Report Preview -->
            <Border Background="White"
                    BorderBrush="#EAE7F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">

                <StackPanel>

                    <!-- Preview Header -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Report Preview"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#29243B"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Print Preview"
                                Padding="18,9"
                                Background="#7952B3"
                                Foreground="White"
                                Click="PrintPreviewButton_Click"
                                IsEnabled="{Binding HasGeneratedReport}"/>
                                        </Grid>

                    <!-- Initial Instruction -->
                    <TextBlock Text="Generate a report to display consolidated clinic activity."
                               Foreground="#777184"
                               FontSize="13"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,24,0,24">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGeneratedReport}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Generated Report Content -->
                    <StackPanel Visibility="{Binding HasGeneratedReport, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <!-- Report Metadata -->
                        <Border Background="#F8F6FB"
                                BorderBrush="#EAE7F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16"
                                Margin="0,0,0,20">

                            <StackPanel>

                                <TextBlock Text="CLINIC ACTIVITY SUMMARY"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#7952B3"
                                           Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Activity Date Range"
                                                   FontSize="11"
                                                   Foreground="#777184"/>

                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#29243B">
                                            <Run Text="{Binding StartDateDisplay, Mode=OneWay}"/>
                                            <Run Text=" — "/>           
                                            <Run Text="{Binding EndDateDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Generated"
                                                   FontSize="11"
                                                   Foreground="#777184"/>

                                        <TextBlock Text="{Binding GeneratedAtDisplay}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#29243B"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Appointment status reflects the current recorded status of appointments within the selected period."
                                           FontSize="11"
                                           Foreground="#777184"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0"/>

                            </StackPanel>
                        </Border>

                        <!-- Activity Totals -->
                        <TextBlock Text="Clinic Activity Totals"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#29243B"
                                   Margin="0,0,0,12"/>

                        <UniformGrid Columns="3">

                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Patient Registrations"
                                               Style="{StaticResource MetricLabelStyle}"/>

                                    <TextBlock Text="{Binding Report.TotalPatientRegistrations}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Foreground="#7952B3"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Pregnancy Records"
                                               Style="{StaticResource MetricLabelStyle}"/>

                                    <TextBlock Text="{Binding Report.TotalPregnancyRecords}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Foreground="#B879A8"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Prenatal Visits"
                                               Style="{StaticResource MetricLabelStyle}"/>

                                    <TextBlock Text="{Binding Report.TotalPrenatalVisits}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Foreground="#3D8D9B"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Laboratory Records"
                                               Style="{StaticResource MetricLabelStyle}"/>

                                    <TextBlock Text="{Binding Report.TotalLaboratoryResults}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Foreground="#C58A45"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Appointments"
                                               Style="{StaticResource MetricLabelStyle}"/>

                                    <TextBlock Text="{Binding Report.TotalAppointments}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Foreground="#568B72"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Unique Patients Served"
                                               Style="{StaticResource MetricLabelStyle}"/>

                                    <TextBlock Text="{Binding Report.UniquePatientsServed}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Foreground="#7952B3"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Unassigned Activity Date"
                                               Style="{StaticResource MetricLabelStyle}"/>

                                    <TextBlock Text="{Binding Report.UnassignedActivityDateCount}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Foreground="#64748B"/>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                        <TextBlock Text="Unassigned Activity Date counts records without an applicable date only when no date range is selected. These records are not assigned to a month."
                                   FontSize="11"
                                   Foreground="#777184"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <!-- Appointment Status -->
                        <TextBlock Text="Appointment Status Breakdown"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#29243B"
                                   Margin="0,14,0,12"/>

                        <Border Background="#F8F6FB"
                                BorderBrush="#EAE7F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18"
                                Margin="0,0,0,22">

                            <UniformGrid Columns="5">

                                <StackPanel>
                                    <TextBlock Text="Scheduled"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding Report.ScheduledAppointments}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#7952B3"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Confirmed"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding Report.ConfirmedAppointments}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#3D8D9B"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Completed"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding Report.CompletedAppointments}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#568B72"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Cancelled"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding Report.CancelledAppointments}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#C58A45"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="No-show"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding Report.NoShowAppointments}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#C45C65"/>
                                </StackPanel>

                            </UniformGrid>
                        </Border>

                        <!-- Monthly Activity Chart -->
                        <TextBlock Text="Monthly Clinic Activity"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#29243B"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Comparison of registrations and recorded clinic activities by month."
                                   FontSize="12"
                                   Foreground="#777184"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <Border Background="#FFFFFF"
                                BorderBrush="#EAE7F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16"
                                MinHeight="320">

                            <lvc:CartesianChart Series="{Binding MonthlyActivitySeries}"
                                                XAxes="{Binding MonthlyActivityXAxes}"
                                                YAxes="{Binding MonthlyActivityYAxes}"
                                                LegendPosition="Bottom"
                                                TooltipPosition="Top"
                                                AnimationsSpeed="0:0:0.3"/>
                        </Border>

                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
