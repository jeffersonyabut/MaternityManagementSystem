<UserControl x:Class="MaternityManagementSystem.Views.Reports.AppointmentReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaternityManagementSystem.Converters"
             Background="#F5F5FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:UtcToLocalDateTimeConverter x:Key="UtcToLocalDateTimeConverter"/>

        <Style x:Key="ReportLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555064"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28">

            <!-- Navigation -->
            <Button Content="← Back to Reports"
                    HorizontalAlignment="Left"
                    Padding="12,7"
                    Margin="0,0,0,24"
                    Click="BackButton_Click"/>

            <!-- Header -->
            <TextBlock Text="GOLDDIE · CLINIC MANAGEMENT"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#7952B3"/>

            <TextBlock Text="Appointment Report"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#29243B"
                       Margin="0,5,0,0"/>

            <TextBlock Text="Review scheduled appointments and patient appointment records."
                       FontSize="13"
                       Foreground="#777184"
                       Margin="0,5,0,24"/>

            <!-- Report Configuration -->
            <Border Background="White"
                    BorderBrush="#EAE7F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Report Configuration"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#29243B"/>

                    <TextBlock Text="Filter appointments by appointment date, patient, or appointment status."
                               FontSize="13"
                               Foreground="#777184"
                               TextWrapping="Wrap"
                               Margin="0,7,0,22"/>

                    <!-- Date Filters -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Appointment Date · From"
                                       Style="{StaticResource ReportLabelStyle}"/>

                            <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,16"
                                        MinHeight="38"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Appointment Date · To"
                                       Style="{StaticResource ReportLabelStyle}"/>

                            <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,16"
                                        MinHeight="38"/>
                        </StackPanel>
                    </Grid>

                    <!-- Patient Search -->
                    <TextBlock Text="Search Patient"
                               Style="{StaticResource ReportLabelStyle}"/>

                    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="38"
                             Padding="9,6"
                             Margin="0,0,0,16"
                             ToolTip="Search by patient number or patient name"/>

                    <!-- Status Filter -->
                    <TextBlock Text="Appointment Status"
                               Style="{StaticResource ReportLabelStyle}"/>

                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                              MinHeight="38"
                              Padding="9,6"
                              Margin="0,0,0,20"/>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Clear Filters"
                                Command="{Binding ClearFiltersCommand}"
                                Padding="18,10"
                                Margin="0,0,10,0"/>

                        <Button Content="Generate Report"
                                Command="{Binding GenerateReportCommand}"
                                Padding="18,10"
                                Background="#7952B3"
                                Foreground="White"
                                IsEnabled="{Binding IsNotLoading}"/>

                    </StackPanel>

                    <!-- Loading -->
                    <TextBlock Text="Generating report..."
                               Foreground="#7952B3"
                               FontSize="12"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Right"
                               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Error -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#C62828"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                </StackPanel>
            </Border>

            <!-- Report Preview -->
            <Border Background="White"
                    BorderBrush="#EAE7F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">

                <StackPanel>

                    <!-- Preview Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Report Preview"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#29243B"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Print Preview"
                                Click="PrintPreviewButton_Click"
                                Padding="16,9"
                                Background="#7952B3"
                                Foreground="White"
                                IsEnabled="{Binding HasAppointments}"/>
                    </Grid>

                    <!-- Initial Instruction -->
                    <TextBlock Text="Generate a report to display appointment records."
                               Foreground="#777184"
                               FontSize="13"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,24,0,12">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGeneratedReport}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Report Summary -->
                    <Border Background="#F8F6FB"
                            BorderBrush="#EAE7F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,12,0,18">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGeneratedReport}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>

                            <TextBlock Text="REPORT SUMMARY"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#7952B3"
                                       Margin="0,0,0,12"/>

                            <UniformGrid Columns="2">

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Total Appointments"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding TotalAppointments}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#7952B3"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Unique Patients"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding UniquePatientCount}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#29243B"/>
                                </StackPanel>

                            </UniformGrid>

                            <Separator Margin="0,14,0,14"
                                       Background="#EAE7F0"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Margin="0,0,12,0">
                                    <TextBlock Text="Appointment Date Range"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#29243B">
                                        <Run Text="{Binding Report.StartDate, TargetNullValue=Any, StringFormat={}{0:MMM dd, yyyy}}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding Report.EndDate, TargetNullValue=Any, StringFormat={}{0:MMM dd, yyyy}}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Appointment Status"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding Report.Status}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#29243B"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,12,0,0"
                                       FontSize="11"
                                       Foreground="#777184">
                                <Run Text="Patient Search: "/>
                                <Run Text="{Binding Report.SearchTerm, TargetNullValue=All patients}"/>
                            </TextBlock>

                            <TextBlock Margin="0,10,0,0"
                                       FontSize="11"
                                       Foreground="#777184">
                                <Run Text="Generated: "/>
                                <Run Text="{Binding Report.GeneratedAtUtc,
                                                    Converter={StaticResource UtcToLocalDateTimeConverter},
                                                    StringFormat={}{0:MMM dd, yyyy hh:mm tt}}"/>
                            </TextBlock>

                        </StackPanel>
                    </Border>

                    <!-- No Matching Records -->
                    <TextBlock Text="No appointments found for the selected filters."
                               Foreground="#777184"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,24,0,24">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoAppointments}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Appointment Table -->
                    <DataGrid ItemsSource="{Binding Report.Appointments}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              MinHeight="180"
                              MaxHeight="600"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAppointments}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding AppointmentDate, StringFormat={}{0:MMM dd, yyyy}}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Start Time"
                                                Binding="{Binding StartTime}"
                                                Width="100"/>

                            <DataGridTextColumn Header="End Time"
                                                Binding="{Binding EndTime, TargetNullValue=—}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Patient No."
                                                Binding="{Binding Patient.PatientNumber}"
                                                Width="105"/>

                            <DataGridTemplateColumn Header="Patient Name"
                                                    Width="165">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1} {2}">
                                                    <Binding Path="Patient.FirstName"/>
                                                    <Binding Path="Patient.MiddleName"/>
                                                    <Binding Path="Patient.LastName"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Purpose"
                                                Binding="{Binding Purpose}"
                                                Width="180"/>

                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="100"/>

                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
