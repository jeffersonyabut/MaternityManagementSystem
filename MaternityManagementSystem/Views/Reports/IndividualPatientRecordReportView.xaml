<UserControl x:Class="MaternityManagementSystem.Views.Reports.IndividualPatientRecordReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5FA">

    <UserControl.Resources>

        <SolidColorBrush x:Key="PrimaryPurple" Color="#7952B3"/>
        <SolidColorBrush x:Key="MainText" Color="#29243B"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#777184"/>
        <SolidColorBrush x:Key="CardBorder" Color="#EAE7F0"/>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MainText}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MainText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ReportDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EAE7F0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F2FA"/>
            <Setter Property="Foreground" Value="#51436B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="30">

                <!-- Header -->
                <StackPanel Margin="0,0,0,24">

                    <TextBlock Text="GOLDDIE · CLINIC MANAGEMENT"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryPurple}"/>

                    <TextBlock Text="Individual Patient Record"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource MainText}"
                               Margin="0,6,0,4"/>

                    <TextBlock Text="Complete patient information and clinical history."
                               FontSize="13"
                               Foreground="{StaticResource SecondaryText}"/>

                </StackPanel>

                <!-- Report Actions -->
                <Border Style="{StaticResource SectionCardStyle}"
                        Padding="16">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Report Preview"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MainText}"/>

                            <TextBlock Text="Review the patient's complete record before printing."
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryText}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <Button Grid.Column="1"
                                Content="Back"
                                Padding="18,9"
                                Margin="8,0"
                                Background="White"
                                Foreground="{StaticResource PrimaryPurple}"
                                BorderBrush="{StaticResource PrimaryPurple}"
                                BorderThickness="1"
                                Click="BackButton_Click"/>

                        <Button Grid.Column="2"
                                Content="Print Preview"
                                Padding="18,9"
                                Margin="8,0,0,0"
                                Background="{StaticResource PrimaryPurple}"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="PrintPreviewButton_Click"/>

                    </Grid>
                </Border>

                <!-- 1. Patient Information -->
                <Border Style="{StaticResource SectionCardStyle}">

                    <StackPanel>

                        <TextBlock Text="1. Patient Information"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,16">
                                <TextBlock Text="Patient Number" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Patient.PatientNumber}" Style="{StaticResource FieldValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,16,16">
                                <TextBlock Text="First Name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Patient.FirstName}" Style="{StaticResource FieldValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="Middle Name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Patient.MiddleName, TargetNullValue=—}" Style="{StaticResource FieldValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,16">
                                <TextBlock Text="Last Name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Patient.LastName}" Style="{StaticResource FieldValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,16,16">
                                <TextBlock Text="Date of Birth" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Patient.DateOfBirth, TargetNullValue=—}" Style="{StaticResource FieldValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="Sex" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Patient.Sex, TargetNullValue=—}" Style="{StaticResource FieldValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Civil Status" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Patient.CivilStatus, TargetNullValue=—}" Style="{StaticResource FieldValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="Contact Number" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Patient.ContactNumber, TargetNullValue=—}" Style="{StaticResource FieldValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Email Address" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Patient.Email, TargetNullValue=—}" Style="{StaticResource FieldValueStyle}"/>
                            </StackPanel>

                        </Grid>

                        <Separator Margin="0,18,0,16" Background="#EAE7F0"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Residential Address" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Patient.Address, TargetNullValue=—}" Style="{StaticResource FieldValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Registration Date" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Patient.CreatedAtUtc, StringFormat={}{0:MMM dd, yyyy}}" Style="{StaticResource FieldValueStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,18,0,16" Background="#EAE7F0"/>

                        <TextBlock Text="Emergency Contact"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource MainText}"
                                   Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Contact Name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Patient.EmergencyContactName, TargetNullValue=—}" Style="{StaticResource FieldValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Contact Number" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding Patient.EmergencyContactNumber, TargetNullValue=—}" Style="{StaticResource FieldValueStyle}"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- 2. Pregnancy and Obstetric History -->
                <Border Style="{StaticResource SectionCardStyle}">

                    <StackPanel>

                        <TextBlock Text="2. Pregnancy and Obstetric History"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="Pregnancy Records"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MainText}"
                                   Margin="0,0,0,10"/>

                        <DataGrid ItemsSource="{Binding Pregnancies}"
                                  Style="{StaticResource ReportDataGridStyle}"
                                  MinHeight="90">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                                <DataGridTextColumn Header="LMP" Binding="{Binding LastMenstrualPeriod}" Width="*"/>
                                <DataGridTextColumn Header="EDD" Binding="{Binding EstimatedDueDate}" Width="*"/>
                                <DataGridTextColumn Header="Outcome" Binding="{Binding PregnancyOutcome}" Width="*"/>
                                <DataGridTextColumn Header="Delivery Method" Binding="{Binding DeliveryMethod}" Width="*"/>
                                <DataGridTextColumn Header="Living Children" Binding="{Binding LivingChildrenCount}" Width="*"/>
                            </DataGrid.Columns>

                        </DataGrid>

                        <!-- GTPAL Summary -->
                        <TextBlock Text="Obstetric Summary (GTPAL)"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MainText}"
                                   Margin="0,22,0,10"/>

                        <Border Background="#F7F3FC"
                                BorderBrush="#EAE7F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">

                            <StackPanel>

                                <UniformGrid Columns="5">

                                    <StackPanel Margin="4">
                                        <TextBlock Text="G"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#777184"/>
                                        <TextBlock Text="{Binding ObstetricHistory.Gravida}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="#7952B3"/>
                                        <TextBlock Text="Gravida"
                                                   FontSize="11"
                                                   Foreground="#777184"/>
                                    </StackPanel>

                                    <StackPanel Margin="4">
                                        <TextBlock Text="T"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#777184"/>
                                        <TextBlock Text="{Binding ObstetricHistory.Term}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="#7952B3"/>
                                        <TextBlock Text="Term"
                                                   FontSize="11"
                                                   Foreground="#777184"/>
                                    </StackPanel>

                                    <StackPanel Margin="4">
                                        <TextBlock Text="P"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#777184"/>
                                        <TextBlock Text="{Binding ObstetricHistory.Preterm}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="#7952B3"/>
                                        <TextBlock Text="Preterm"
                                                   FontSize="11"
                                                   Foreground="#777184"/>
                                    </StackPanel>

                                    <StackPanel Margin="4">
                                        <TextBlock Text="A"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#777184"/>
                                        <TextBlock Text="{Binding ObstetricHistory.Abortion}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="#7952B3"/>
                                        <TextBlock Text="Abortion"
                                                   FontSize="11"
                                                   Foreground="#777184"/>
                                    </StackPanel>

                                    <StackPanel Margin="4">
                                        <TextBlock Text="L"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#777184"/>
                                        <TextBlock Text="{Binding ObstetricHistory.LivingChildrenDisplay}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="#7952B3"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="Living"
                                                   FontSize="11"
                                                   Foreground="#777184"/>
                                    </StackPanel>

                                </UniformGrid>

                                <Separator Margin="0,12,0,10"
                                           Background="#EAE7F0"/>

                                <TextBlock Text="{Binding ObstetricHistory.UnclassifiedPregnancies,
                                                          StringFormat='Unclassified pregnancies: {0}'}"
                                           FontSize="11"
                                           Foreground="#777184"/>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- 3. Prenatal Visits -->
                <Border Style="{StaticResource SectionCardStyle}">

                    <StackPanel>

                        <TextBlock Text="3. Prenatal Visit History"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <DataGrid ItemsSource="{Binding PrenatalVisits}"
                                  Style="{StaticResource ReportDataGridStyle}"
                                  MinHeight="90">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Visit Date" Binding="{Binding VisitDate}" Width="150"/>
                                <DataGridTextColumn Header="Clinical Notes" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>
                </Border>

                <!-- 4. Vital Signs -->
                <Border Style="{StaticResource SectionCardStyle}">

                    <StackPanel>

                        <TextBlock Text="4. Vital Signs History"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <DataGrid ItemsSource="{Binding VitalSigns}"
                                  Style="{StaticResource ReportDataGridStyle}"
                                  MinHeight="90">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Recorded" Binding="{Binding RecordedAtUtc, StringFormat={}{0:MMM dd, yyyy}}" Width="*"/>
                                <DataGridTextColumn Header="Blood Pressure" Binding="{Binding SystolicBloodPressure}" Width="*"/>
                                <DataGridTextColumn Header="Heart Rate" Binding="{Binding HeartRate}" Width="*"/>
                                <DataGridTextColumn Header="Respiratory Rate" Binding="{Binding RespiratoryRate}" Width="*"/>
                                <DataGridTextColumn Header="Temperature" Binding="{Binding TemperatureCelsius}" Width="*"/>
                                <DataGridTextColumn Header="SpO₂" Binding="{Binding OxygenSaturation}" Width="*"/>
                                <DataGridTextColumn Header="Weight (kg)" Binding="{Binding WeightKg}" Width="*"/>
                                <DataGridTextColumn Header="Fetal HR" Binding="{Binding FetalHeartRate}" Width="*"/>
                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>
                </Border>

                <!-- 5. Laboratory Results -->
                <Border Style="{StaticResource SectionCardStyle}">

                    <StackPanel>

                        <TextBlock Text="5. Laboratory Results"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <DataGrid ItemsSource="{Binding LaboratoryResults}"
                                  Style="{StaticResource ReportDataGridStyle}"
                                  MinHeight="90">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Test Date" Binding="{Binding TestDate}" Width="*"/>
                                <DataGridTextColumn Header="Test Name" Binding="{Binding TestName}" Width="*"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*"/>
                                <DataGridTextColumn Header="Reference Range" Binding="{Binding ReferenceRange}" Width="*"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>
                </Border>

                <!-- Report Footer -->
                <TextBlock Text="END OF INDIVIDUAL PATIENT RECORD"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryText}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,20"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
