<UserControl x:Class="MaternityManagementSystem.Views.Reports.LaboratoryResultsReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaternityManagementSystem.Converters"
             xmlns:models="clr-namespace:MaternityManagementSystem.Models"
             Background="#F5F5FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <converters:RegionalDateOnlyConverter
            x:Key="RegionalDateOnlyConverter"/>

        <converters:RegionalDateTimeConverter
            x:Key="RegionalDateTimeConverter"/>

        <Style x:Key="ReportLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555064"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="ReportCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28">

            <!-- Navigation -->
            <Button Content="← Back to Reports"
                    HorizontalAlignment="Left"
                    Padding="12,7"
                    Margin="0,0,0,24"
                    Click="BackButton_Click"/>

            <!-- Header -->
            <TextBlock Text="GOLDDIE · CLINIC MANAGEMENT"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#7952B3"/>

            <TextBlock Text="Laboratory Results Report"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#29243B"
                       Margin="0,5,0,0"/>

            <TextBlock Text="Review laboratory findings and recorded patient test results."
                       FontSize="13"
                       Foreground="#777184"
                       Margin="0,5,0,24"/>

            <!-- Report Configuration -->
            <Border Background="White"
                    BorderBrush="#EAE7F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Report Configuration"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#29243B"/>

                    <TextBlock Text="Filter laboratory records by request or performed date, patient, or laboratory test."
                               FontSize="13"
                               Foreground="#777184"
                               TextWrapping="Wrap"
                               Margin="0,7,0,22"/>

                    <!-- Date Filters -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Record Date · From"
                                       Style="{StaticResource ReportLabelStyle}"/>

                            <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,16"
                                        MinHeight="38"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Record Date · To"
                                       Style="{StaticResource ReportLabelStyle}"/>

                            <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,16"
                                        MinHeight="38"/>
                        </StackPanel>
                    </Grid>

                    <!-- Patient Search -->
                    <TextBlock Text="Search Patient"
                               Style="{StaticResource ReportLabelStyle}"/>

                    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="38"
                             Padding="9,6"
                             Margin="0,0,0,16"
                             ToolTip="Search by patient number or patient name"/>

                    <!-- Laboratory Test Search -->
                    <TextBlock Text="Laboratory Test Name"
                               Style="{StaticResource ReportLabelStyle}"/>

                    <TextBox Text="{Binding TestName, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="38"
                             Padding="9,6"
                             Margin="0,0,0,20"
                             ToolTip="Enter a laboratory test name or partial test name"/>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Clear Filters"
                                Command="{Binding ClearFiltersCommand}"
                                Padding="18,10"
                                Margin="0,0,10,0"/>

                        <Button Content="Generate Report"
                                Command="{Binding GenerateReportCommand}"
                                Padding="18,10"
                                Background="#7952B3"
                                Foreground="White"
                                IsEnabled="{Binding IsNotLoading}"/>

                    </StackPanel>

                    <!-- Loading -->
                    <TextBlock Text="Generating report..."
                               Foreground="#7952B3"
                               FontSize="12"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Right"
                               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Error -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#C62828"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                </StackPanel>
            </Border>

            <!-- Report Preview -->
            <Border Background="White"
                    BorderBrush="#EAE7F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">

                <StackPanel>

                    <!-- Preview Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Report Preview"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#29243B"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Print Preview"
                                Click="PrintPreviewButton_Click"
                                Padding="16,9"
                                Background="#7952B3"
                                Foreground="White"
                                IsEnabled="{Binding HasLaboratoryResults}"/>
                    </Grid>

                    <!-- Initial Instruction -->
                    <TextBlock Text="Generate a report to display laboratory results."
                               Foreground="#777184"
                               FontSize="13"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,24,0,12">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGeneratedReport}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Report Summary -->
                    <Border Background="#F8F6FB"
                            BorderBrush="#EAE7F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,12,0,18">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGeneratedReport}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>

                            <TextBlock Text="REPORT SUMMARY"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#7952B3"
                                       Margin="0,0,0,12"/>

                            <UniformGrid Columns="3">

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Total Laboratory Records"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding TotalLaboratoryRecords}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#7952B3"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Requested"
                                               FontSize="11"
                                               Foreground="#777184"/>
                                    <TextBlock Text="{Binding RequestedCount}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#29243B"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Awaiting Result"
                                               FontSize="11"
                                               Foreground="#777184"/>
                                    <TextBlock Text="{Binding AwaitingResultCount}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#29243B"/>
                                </StackPanel>

                                <StackPanel Margin="0,12,12,0">
                                    <TextBlock Text="Resulted"
                                               FontSize="11"
                                               Foreground="#777184"/>
                                    <TextBlock Text="{Binding ResultedCount}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#29243B"/>
                                </StackPanel>

                                <StackPanel Margin="0,12,12,0">
                                    <TextBlock Text="Unknown / Unclassified"
                                               FontSize="11"
                                               Foreground="#777184"/>
                                    <TextBlock Text="{Binding UnknownUnclassifiedCount}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#29243B"/>
                                </StackPanel>

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Unique Patients"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding UniquePatientCount}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#29243B"/>
                                </StackPanel>

                            </UniformGrid>

                            <Separator Margin="0,14,0,14"
                                       Background="#EAE7F0"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Margin="0,0,12,0">
                                    <TextBlock Text="Record Date Range"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#29243B">
                                        <Run Text="{Binding Report.StartDate,
                                                            Converter={StaticResource RegionalDateOnlyConverter},
                                                            TargetNullValue=Any}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding Report.EndDate,
                                                            Converter={StaticResource RegionalDateOnlyConverter},
                                                            TargetNullValue=Any}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Laboratory Test"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding Report.TestName, TargetNullValue=All tests}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#29243B"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,12,0,0"
                                       FontSize="11"
                                       Foreground="#777184">
                                <Run Text="Patient Search: "/>
                                <Run Text="{Binding Report.SearchTerm, TargetNullValue=All patients}"/>
                            </TextBlock>

                            <TextBlock Margin="0,10,0,0"
                                       FontSize="11"
                                       Foreground="#777184">
                                <Run Text="Generated: "/>
                                <Run Text="{Binding Report.GeneratedAtUtc,
                                                    Converter={StaticResource RegionalDateTimeConverter}}"/>
                            </TextBlock>

                        </StackPanel>
                    </Border>

                    <!-- No Matching Records -->
                    <TextBlock Text="No laboratory records found for the selected filters."
                               Foreground="#777184"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,24,0,24">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoLaboratoryResults}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Laboratory Results Table -->
                    <DataGrid ItemsSource="{Binding Report.LaboratoryResults}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              MinHeight="180"
                              MaxHeight="600"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLaboratoryResults}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Status" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource ReportCellTextStyle}">
                                                    <Setter Property="Text" Value="Unknown / Unclassified"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="{x:Static models:LaboratoryResultStatus.Requested}">
                                                            <Setter Property="Text" Value="Requested"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="{x:Static models:LaboratoryResultStatus.AwaitingResult}">
                                                            <Setter Property="Text" Value="Awaiting Result"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="{x:Static models:LaboratoryResultStatus.Resulted}">
                                                            <Setter Property="Text" Value="Resulted"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Requested Date" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="—">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource ReportCellTextStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RequestedDate}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding RequestedDate, Converter={StaticResource RegionalDateOnlyConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource ReportCellTextStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RequestedDate}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Test Date" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="—">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource ReportCellTextStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TestDate}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding TestDate, Converter={StaticResource RegionalDateOnlyConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource ReportCellTextStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TestDate}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Patient No."
                                                Binding="{Binding Patient.PatientNumber}"
                                                Width="110"
                                                ElementStyle="{StaticResource ReportCellTextStyle}"/>

                            <DataGridTemplateColumn Header="Patient Name" Width="165">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource ReportCellTextStyle}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1} {2}">
                                                    <Binding Path="Patient.FirstName"/>
                                                    <Binding Path="Patient.MiddleName"/>
                                                    <Binding Path="Patient.LastName"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Test Name"
                                                Binding="{Binding TestName}"
                                                Width="150"
                                                ElementStyle="{StaticResource ReportCellTextStyle}"/>

                            <DataGridTemplateColumn Header="Result" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="—">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource ReportCellTextStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Result}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Result}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource ReportCellTextStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Result}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Unit"
                                                Binding="{Binding Unit}"
                                                Width="75"
                                                ElementStyle="{StaticResource ReportCellTextStyle}"/>

                            <DataGridTextColumn Header="Reference Range"
                                                Binding="{Binding ReferenceRange}"
                                                Width="125"
                                                ElementStyle="{StaticResource ReportCellTextStyle}"/>

                            <DataGridTextColumn Header="Notes"
                                                Binding="{Binding Notes}"
                                                Width="*"
                                                ElementStyle="{StaticResource ReportCellTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
