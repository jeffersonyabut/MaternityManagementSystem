<UserControl x:Class="MaternityManagementSystem.Views.Reports.IndividualPatientRecordSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Background="#F5F5FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">

                <!-- Header -->
                <StackPanel Margin="0,0,0,24">

                    <Button Content="←  Back to Reports"
                            HorizontalAlignment="Left"
                            Padding="14,8"
                            Margin="0,0,0,18"
                            Background="White"
                            Foreground="#7952B3"
                            BorderBrush="#EAE7F0"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Click="BackButton_Click"/>

                    <TextBlock Text="GOLDDIE · CLINIC MANAGEMENT"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#7952B3"/>

                    <TextBlock Text="Individual Patient Record"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#29243B"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="Select a registered patient to generate their complete individual record."
                               FontSize="13"
                               Foreground="#777184"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Patient Search -->
                <Border Background="White"
                        BorderBrush="#EAE7F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,0,16">

                    <StackPanel>

                        <TextBlock Text="Find Patient"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#29243B"
                                   Margin="0,0,0,12"/>

                        <TextBox Padding="12,10"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Search by patient number, name, or contact number"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Search by patient number, name, or contact number."
                                   FontSize="11"
                                   Foreground="#777184"
                                   Margin="2,7,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Patient Selection -->
                <Border Background="White"
                        BorderBrush="#EAE7F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Table Heading -->
                        <StackPanel Grid.Row="0"
                                    Margin="0,0,0,14">

                            <TextBlock Text="Registered Patients"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#29243B"/>

                            <TextBlock Text="Select one patient from the list."
                                       FontSize="12"
                                       Foreground="#777184"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Patient Table -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Patients}"
                                  SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  MinHeight="300">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Patient No."
                                                    Binding="{Binding PatientNumber}"
                                                    Width="150"/>

                                <DataGridTextColumn Header="First Name"
                                                    Binding="{Binding FirstName}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Middle Name"
                                                    Binding="{Binding MiddleName}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Last Name"
                                                    Binding="{Binding LastName}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Date of Birth"
                                                    Binding="{Binding DateOfBirth, StringFormat={}{0:MMM dd, yyyy}}"
                                                    Width="140"/>

                                <DataGridTextColumn Header="Contact Number"
                                                    Binding="{Binding ContactNumber}"
                                                    Width="150"/>

                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Footer -->
                        <Grid Grid.Row="2"
                              Margin="4,14,4,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding StatusMessage}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="#777184"
                                       Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Button Content="Previous"
                                        Command="{Binding PreviousPageCommand}"
                                        IsEnabled="{Binding CanGoToPreviousPage}"
                                        Padding="12,7"
                                        Margin="0,0,8,0"/>

                                <TextBlock VerticalAlignment="Center"
                                           Margin="4,0,12,0">

                                    <Run Text="Page "/>
                                    <Run Text="{Binding CurrentPage}"/>
                                    <Run Text=" of "/>
                                    <Run Text="{Binding TotalPages}"/>

                                </TextBlock>

                                <Button Content="Next"
                                        Command="{Binding NextPageCommand}"
                                        IsEnabled="{Binding CanGoToNextPage}"
                                        Padding="12,7"/>

                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Generate Report -->
                <Border Background="White"
                        BorderBrush="#EAE7F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,16,0,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Generate Patient Report"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#29243B"/>

                            <TextBlock Text="Select a patient above to prepare their individual record."
                                       FontSize="12"
                                       Foreground="#777184"
                                       TextWrapping="Wrap"
                                       Margin="0,5,12,0"/>

                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="12"
                                       Foreground="#C62828"
                                       TextWrapping="Wrap"
                                       Margin="0,8,12,0"/>

                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Generate Report"
                                Command="{Binding GenerateReportCommand}"
                                IsEnabled="{Binding CanGenerateReport}"
                                Padding="20,12"
                                VerticalAlignment="Center"
                                Background="#7952B3"
                                Foreground="White"
                                BorderThickness="0"/>

                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
