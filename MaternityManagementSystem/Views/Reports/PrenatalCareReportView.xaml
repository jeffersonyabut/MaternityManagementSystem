<UserControl x:Class="MaternityManagementSystem.Views.PrenatalCareReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaternityManagementSystem.Converters"
             Background="#F5F5FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <converters:RegionalDateOnlyConverter
            x:Key="RegionalDateOnlyConverter"/>

        <converters:RegionalDateTimeConverter
            x:Key="RegionalDateTimeConverter"/>

        <Style x:Key="ReportLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555064"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28">

            <!-- Navigation -->
            <Button Content="← Back to Reports"
                    HorizontalAlignment="Left"
                    Padding="12,7"
                    Margin="0,0,0,24"
                    Click="BackButton_Click"/>

            <!-- Header -->
            <TextBlock Text="GOLDDIE · CLINIC MANAGEMENT"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#7952B3"/>

            <TextBlock Text="Prenatal Care Report"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#29243B"
                       Margin="0,5,0,0"/>

            <TextBlock Text="Review prenatal consultations and recorded vital signs."
                       FontSize="13"
                       Foreground="#777184"
                       Margin="0,5,0,24"/>

            <!-- Report Configuration -->
            <Border Background="White"
                    BorderBrush="#EAE7F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Report Configuration"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#29243B"/>

                    <TextBlock Text="Filter prenatal visits by consultation date or patient."
                               FontSize="13"
                               Foreground="#777184"
                               TextWrapping="Wrap"
                               Margin="0,7,0,22"/>

                    <!-- Date Filters -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Visit Date · From"
                                       Style="{StaticResource ReportLabelStyle}"/>

                            <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,16"
                                        MinHeight="38"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Visit Date · To"
                                       Style="{StaticResource ReportLabelStyle}"/>

                            <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,16"
                                        MinHeight="38"/>
                        </StackPanel>
                    </Grid>

                    <!-- Patient Search -->
                    <TextBlock Text="Search Patient"
                               Style="{StaticResource ReportLabelStyle}"/>

                    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="38"
                             Padding="9,6"
                             Margin="0,0,0,20"
                             ToolTip="Search by patient number or patient name"/>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Clear Filters"
                                Command="{Binding ClearFiltersCommand}"
                                Padding="18,10"
                                Margin="0,0,10,0"/>

                        <Button Content="Generate Report"
                                Command="{Binding GenerateReportCommand}"
                                Padding="18,10"
                                Background="#7952B3"
                                Foreground="White"/>

                    </StackPanel>

                    <!-- Loading -->
                    <TextBlock Text="Generating report..."
                               Foreground="#7952B3"
                               FontSize="12"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Right"
                               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Error -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#C62828"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                </StackPanel>
            </Border>

            <!-- Report Preview -->
            <Border Background="White"
                    BorderBrush="#EAE7F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">

                <StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Report Preview"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#29243B"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Print Preview"
                                Click="PrintPreviewButton_Click"
                                Padding="16,9"
                                Background="#7952B3"
                                Foreground="White"
                                IsEnabled="{Binding HasGeneratedReport}"/>
                    </Grid>

                    <!-- Initial Instruction -->
                    <TextBlock Text="Generate a report to display prenatal care records."
                               Foreground="#777184"
                               FontSize="13"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,24,0,12">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGeneratedReport}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Report Summary -->
                    <Border Background="#F8F6FB"
                            BorderBrush="#EAE7F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,12,0,18">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGeneratedReport}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>

                            <TextBlock Text="REPORT SUMMARY"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#7952B3"
                                       Margin="0,0,0,12"/>

                            <UniformGrid Columns="3">

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Total Patients"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding Report.TotalPatients}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#7952B3"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Prenatal Visits"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding Report.TotalPrenatalVisits}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#29243B"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Vital Sign Records"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding Report.TotalVitalSigns}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#29243B"/>
                                </StackPanel>

                            </UniformGrid>

                            <Separator Margin="0,14,0,14"
                                       Background="#EAE7F0"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Margin="0,0,12,0">
                                    <TextBlock Text="Visit Date Range"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#29243B">
                                        <Run Text="{Binding Report.StartDate,
                                                            Converter={StaticResource RegionalDateOnlyConverter},
                                                            TargetNullValue=Any}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding Report.EndDate,
                                                            Converter={StaticResource RegionalDateOnlyConverter},
                                                            TargetNullValue=Any}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Search Term"
                                               FontSize="11"
                                               Foreground="#777184"/>

                                    <TextBlock Text="{Binding Report.SearchTerm, TargetNullValue=None}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#29243B"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,14,0,0"
                                       FontSize="11"
                                       Foreground="#777184">
                                <Run Text="Generated: "/>
                                <Run Text="{Binding Report.GeneratedAtUtc,
                                                    Converter={StaticResource RegionalDateTimeConverter}}"/>
                            </TextBlock>

                        </StackPanel>
                    </Border>

                    <!-- No Matching Records -->
                    <TextBlock Text="No prenatal care records found for the selected filters."
                               Foreground="#777184"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,24,0,24">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoPrenatalVisits}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>


                    <!-- Prenatal Visit Records -->
                    <DataGrid ItemsSource="{Binding Report.PrenatalVisits}"
                              Background="White"
                              Foreground="#29243B"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              RowHeight="38"
                              MinRowHeight="38"
                              MinHeight="180"
                              MaxHeight="600"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F3F0F8"/>
                                <Setter Property="Foreground" Value="#29243B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,12"/>
                                <Setter Property="BorderBrush" Value="#EAE7F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="#29243B"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Visit Date"
                            Binding="{Binding VisitDate, Converter={StaticResource RegionalDateOnlyConverter}}"
                            Width="115"/>

                            <DataGridTextColumn Header="Patient No."
                            Binding="{Binding Pregnancy.Patient.PatientNumber}"
                            Width="115"/>

                            <DataGridTemplateColumn Header="Patient Name"
                                Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="#29243B"
                               TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1} {2}">
                                                    <Binding Path="Pregnancy.Patient.FirstName"/>
                                                    <Binding Path="Pregnancy.Patient.MiddleName"/>
                                                    <Binding Path="Pregnancy.Patient.LastName"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Pregnancy Status"
                            Binding="{Binding Pregnancy.Status}"
                            Width="115"/>

                            <DataGridTextColumn Header="Vital Records"
                            Binding="{Binding VitalSigns.Count}"
                            Width="100"/>

                            <DataGridTemplateColumn Header="Clinical Notes"
                                Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="#29243B"
                               Text="{Binding Notes}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Notes}"
                               TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>


                    <!-- Vital Signs Detail -->
                    <TextBlock Text="Vital Signs Details"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#29243B"
                               Margin="0,24,0,12">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPrenatalVisits}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Report.PrenatalVisits}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Background="#FAF9FC"
                                        BorderBrush="#EAE7F0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,12">

                                    <StackPanel>

                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#7952B3"
                                                   Margin="0,0,0,10">
                                            <Run Text="{Binding VisitDate,
                                                                Converter={StaticResource RegionalDateOnlyConverter}}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Pregnancy.Patient.FirstName}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Pregnancy.Patient.LastName}"/>
                                        </TextBlock>

                                        <DataGrid ItemsSource="{Binding VitalSigns}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  RowHeaderWidth="0"
                                                  MinHeight="55"
                                                  MaxHeight="180"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">

                                            <DataGrid.Columns>

                                                <DataGridTextColumn Header="BP"
                                                                    Binding="{Binding SystolicBloodPressure, StringFormat={}{0} / }"
                                                                    Width="95"/>

                                                <DataGridTextColumn Header="Heart Rate"
                                                                    Binding="{Binding HeartRate, StringFormat={}{0} bpm}"
                                                                    Width="100"/>

                                                <DataGridTextColumn Header="Respiratory Rate"
                                                                    Binding="{Binding RespiratoryRate, StringFormat={}{0} /min}"
                                                                    Width="115"/>

                                                <DataGridTextColumn Header="Temperature"
                                                                    Binding="{Binding TemperatureCelsius, StringFormat={}{0:F1} °C}"
                                                                    Width="105"/>

                                                <DataGridTextColumn Header="SpO₂"
                                                                    Binding="{Binding OxygenSaturation, StringFormat={}{0}%}"
                                                                    Width="85"/>

                                                <DataGridTextColumn Header="Weight"
                                                                    Binding="{Binding WeightKg, StringFormat={}{0:F1} kg}"
                                                                    Width="95"/>

                                                <DataGridTextColumn Header="Fetal HR"
                                                                    Binding="{Binding FetalHeartRate, StringFormat={}{0} bpm}"
                                                                    Width="100"/>

                                            </DataGrid.Columns>
                                        </DataGrid>

                                    </StackPanel>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
