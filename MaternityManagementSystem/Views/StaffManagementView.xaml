<UserControl x:Class="MaternityManagementSystem.Views.StaffManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#6554C0"/>
        <SolidColorBrush x:Key="PageBrush" Color="#F6F7FB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#25243A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#85849A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#EAEAF1"/>

        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#EAEAF1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="StaffDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="58"/>
            <Setter Property="ColumnHeaderHeight" Value="44"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F0F4"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FAFAFC"/>
            <Setter Property="Foreground" Value="#77768B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EAEAF1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#343348"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F0F0F4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8F7FD"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F0EEFA"/>
                    <Setter Property="Foreground" Value="#25243A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource PageBrush}">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="30">

                <!-- PAGE HEADER -->

                <Grid Margin="0,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Staff Management"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="Manage clinic staff accounts, roles, and access status."
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,7,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Content="Edit Selected"
                                Background="White"
                                Foreground="#6554C0"
                                BorderBrush="#6554C0"
                                BorderThickness="1"
                                Padding="18,8"
                                MinHeight="40"
                                FontWeight="SemiBold"
                                FontSize="12"
                                Cursor="Hand"
                                Margin="0,0,10,0"
                                Click="EditStaffButton_Click"/>

                        <Button Content="Change Status"
                                Background="White"
                                Foreground="#D65A68"
                                BorderBrush="#D65A68"
                                BorderThickness="1"
                                Padding="18,8"
                                MinHeight="40"
                                FontWeight="SemiBold"
                                FontSize="12"
                                Cursor="Hand"
                                Margin="0,0,10,0"
                                Click="ChangeStaffStatusButton_Click"/>

                        <Button Content="Reset Password"
                                Background="White"
                                Foreground="#D18B35"
                                BorderBrush="#D18B35"
                                BorderThickness="1"
                                Padding="18,8"
                                MinHeight="40"
                                FontWeight="SemiBold"
                                FontSize="12"
                                Cursor="Hand"
                                Margin="0,0,10,0"
                                Click="ResetStaffPasswordButton_Click"/>
                        
                        <Button Content="+  Add Staff Account"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="18,8"
                                MinHeight="40"
                                FontWeight="SemiBold"
                                FontSize="12"
                                Cursor="Hand"
                                Click="AddStaffButton_Click"/>

                    </StackPanel>

                </Grid>

                <!-- SUMMARY CARDS -->

                <UniformGrid Columns="4" Margin="0,0,0,24">

                    <Border Style="{StaticResource SummaryCardStyle}"
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL ACCOUNTS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"/>

                            <TextBlock Text="{Binding TotalStaffCount}"
                                       FontSize="29"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,12,0,4"/>

                            <TextBlock Text="Registered accounts"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}"
                            Margin="10,0">
                        <StackPanel>
                            <TextBlock Text="ACTIVE ACCOUNTS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"/>

                            <TextBlock Text="{Binding ActiveStaffCount}"
                                       FontSize="29"
                                       FontWeight="Bold"
                                       Foreground="#24966B"
                                       Margin="0,12,0,4"/>

                            <TextBlock Text="Currently active"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}"
                            Margin="10,0">
                        <StackPanel>
                            <TextBlock Text="INACTIVE ACCOUNTS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"/>

                            <TextBlock Text="{Binding InactiveStaffCount}"
                                       FontSize="29"
                                       FontWeight="Bold"
                                       Foreground="#D65A68"
                                       Margin="0,12,0,4"/>

                            <TextBlock Text="Deactivated accounts"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}"
                            Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="ADMINISTRATORS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"/>

                            <TextBlock Text="{Binding AdminCount}"
                                       FontSize="29"
                                       FontWeight="Bold"
                                       Foreground="#6554C0"
                                       Margin="0,12,0,4"/>

                            <TextBlock Text="Administrator accounts"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- STAFF TABLE -->

                <Border Background="White"
                        CornerRadius="12"
                        BorderBrush="#EAEAF1"
                        BorderThickness="1">

                    <StackPanel>

                        <Grid Margin="22,20,22,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Staff Accounts"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"/>

                                <TextBlock Text="View and manage registered clinic accounts."
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="ACCOUNT DIRECTORY"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1"
                                Background="#EAEAF1"/>

                        <!-- SEARCH AND FILTERS -->

                        <Grid Margin="22,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Height="38"
                                     FontSize="12"
                                     Padding="12,9"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#E4E3EB"
                                     BorderThickness="1"
                                     Background="White"
                                     ToolTip="Search username"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                            <ComboBox Grid.Column="1"
                                      Width="130"
                                      Height="38"
                                      Margin="10,0,0,0"
                                      Padding="8,5"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{Binding RoleOptions}"
                                      SelectedItem="{Binding SelectedRole, Mode=TwoWay}"/>

                            <ComboBox Grid.Column="2"
                                      Width="130"
                                      Height="38"
                                      Margin="10,0,0,0"
                                      Padding="8,5"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{Binding AccountStatusOptions}"
                                      SelectedItem="{Binding SelectedAccountStatus, Mode=TwoWay}"/>

                            <Button Grid.Column="3"
                                    Content="Clear"
                                    Height="38"
                                    Margin="10,0,0,0"
                                    Padding="16,0"
                                    Background="White"
                                    Foreground="#55546A"
                                    BorderBrush="#E4E3EB"
                                    BorderThickness="1"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Click="ClearFilters_Click"/>
                        </Grid>

                        <!-- DATA GRID -->

                        <DataGrid x:Name="StaffDataGrid"
                                  Style="{StaticResource StaffDataGridStyle}"
                                  ItemsSource="{Binding StaffMembers}"
                                  SelectedItem="{Binding SelectedStaff, Mode=TwoWay}"
                                  MinHeight="250"
                                  MaxHeight="500">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding Id}"
                                                    Width="0.6*"/>

                                <DataGridTextColumn Header="USERNAME"
                                                    Binding="{Binding Username}"
                                                    Width="1.6*"/>

                                <DataGridTextColumn Header="ROLE"
                                                    Binding="{Binding Role}"
                                                    Width="1*"/>


                                <DataGridTemplateColumn Header="ACCOUNT STATUS" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="StatusBadge"
                                                    Background="#E5F5EE"
                                                    CornerRadius="12"
                                                    Padding="10,5"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">

                                                <TextBlock x:Name="StatusText"
                                                           Text="Active"
                                                           Foreground="#24966B"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}"
                                                             Value="False">

                                                    <Setter TargetName="StatusBadge"
                                                            Property="Background"
                                                            Value="#FCEAEC"/>

                                                    <Setter TargetName="StatusText"
                                                            Property="Text"
                                                            Value="Inactive"/>

                                                    <Setter TargetName="StatusText"
                                                            Property="Foreground"
                                                            Value="#D65A68"/>

                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>



                                <DataGridTextColumn Header="DATE CREATED"
                                                    Binding="{Binding CreatedAtRegionalDisplay}"
                                                    Width="1.5*"/>
                                
                            </DataGrid.Columns>

                        </DataGrid>

                        <!-- FOOTER -->

                        <Border BorderBrush="#EAEAF1"
                                BorderThickness="0,1,0,0"
                                Padding="22,15">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding StaffMembers.Count,
                                    StringFormat='Showing {0} account(s)'}"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding StatusMessage}"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                        </Border>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
