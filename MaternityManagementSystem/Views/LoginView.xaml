<UserControl x:Class="MaternityManagementSystem.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:MaternityManagementSystem.ViewModels"
             mc:Ignorable="d">


    <Grid Background="#F5F6F4">
        <Border Width="340"
                Padding="28"
                CornerRadius="12"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock
                           FontSize="26"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" Text="Golddie"/>

                <TextBlock Text="Maternity Clinic Management"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <TextBox Text="{Binding Username,
                                        UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Username"
                         Margin="0,0,0,18"/>


                <PasswordBox x:Name="PasswordInput"
                        materialDesign:HintAssist.Hint="Password"
                        Margin="0,0,0,20"/>


                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap"
                           Foreground="#315C50"
                           Margin="0,0,0,16"/>


                <Button Content="Sign In"
                        Click="SignInButton_Click"
                        Style="{DynamicResource MaterialDesignRaisedButton}"
                        Height="42"/>   


                <TextBlock Text="Authorized clinic staff only"
                           FontSize="11"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
