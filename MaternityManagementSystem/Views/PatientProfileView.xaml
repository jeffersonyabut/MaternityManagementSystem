<UserControl x:Class="MaternityManagementSystem.Views.PatientProfileView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             xmlns:converters="clr-namespace:MaternityManagementSystem.Converters">
    <UserControl.Resources>
        <converters:RegionalDateOnlyConverter
        x:Key="RegionalDateOnlyConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <Button Content="← Back to Patients"
                        Padding="12,7"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"
                        Click="BackToPatientsButton_Click"/>

                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Patient Profile"
                                   FontSize="28"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="View registered patient information."
                                   FontSize="14"
                                   Opacity="0.7"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Content="Edit Patient"
                            Padding="18,10"
                            VerticalAlignment="Center"
                            Click="EditPatientButton_Click"/>
                </DockPanel>
            </StackPanel>

            <!-- Patient Details -->
            <Border Grid.Row="1"
                    Padding="24"
                    CornerRadius="10"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <TextBlock Text="{Binding Patient.PatientNumber}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Opacity="0.65"/>

                    <TextBlock Margin="0,8,0,24"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Text="{Binding Patient.FirstName}"/>

                    <TextBlock Text="Personal Information"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,16">
                            <TextBlock Text="First Name" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.FirstName}" FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                            <TextBlock Text="Middle Name" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.MiddleName, TargetNullValue=—}" FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,16">
                            <TextBlock Text="Last Name" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.LastName}" FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                            <TextBlock Text="Date of Birth" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.DateOfBirth,
                                              Converter={StaticResource RegionalDateOnlyConverter},
                                              TargetNullValue='Not provided'}"
                                       FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Sex" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.Sex, TargetNullValue=Not provided}" FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="Civil Status" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.CivilStatus, TargetNullValue=Not provided}" FontSize="15"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,0,0,24"/>

                    <TextBlock Text="Contact Information"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Contact Number" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.ContactNumber, TargetNullValue=Not provided}"
                                       TextWrapping="Wrap"
                                       FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Email" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.Email, TargetNullValue=Not provided}"
                                       TextWrapping="Wrap"
                                       FontSize="15"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Address" Opacity="0.65"/>
                        <TextBlock Text="{Binding Patient.Address, TargetNullValue=Not provided}"
                                   TextWrapping="Wrap"
                                   FontSize="15"/>
                    </StackPanel>

                    <Separator Margin="0,0,0,24"/>

                    <TextBlock Text="Emergency Contact"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Contact Name" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.EmergencyContactName, TargetNullValue=Not provided}"
                                       TextWrapping="Wrap"
                                       FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Contact Number" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.EmergencyContactNumber, TargetNullValue=Not provided}"
                                       TextWrapping="Wrap"
                                       FontSize="15"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Loading / Error Status -->
            <TextBlock Grid.Row="2"
                       Text="{Binding StatusMessage}"
                       Margin="4,12,0,0"
                       TextWrapping="Wrap"
                       Opacity="0.8"/>

            <!-- Obstetric History Summary -->
            <Border Grid.Row="3"
                    Margin="0,20,0,0"
                    Padding="24"
                    CornerRadius="10"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <TextBlock Text="Obstetric History"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Summary based on the patient's recorded pregnancy history."
                               Margin="0,6,0,20"
                               Opacity="0.7"/>

                    <UniformGrid Columns="3" Rows="2">

                        <StackPanel Margin="0,0,12,20">
                            <TextBlock Text="{Binding Gravida}"
                                       FontSize="28"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Gravida (G)" Opacity="0.7"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,12,20">
                            <TextBlock Text="{Binding Term}"
                                       FontSize="28"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Term (T)" Opacity="0.7"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,12,20">
                            <TextBlock Text="{Binding Preterm}"
                                       FontSize="28"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Preterm (P)" Opacity="0.7"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{Binding Abortion}"
                                       FontSize="28"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Abortion (A)" Opacity="0.7"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{Binding LivingChildrenDisplay}"
                                       FontSize="28"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Living Children (L)" Opacity="0.7"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{Binding UnclassifiedPregnancies}"
                                       FontSize="28"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Unclassified" Opacity="0.7"/>
                        </StackPanel>

                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Patient Record History -->
            <Border Grid.Row="4"
                    Margin="0,20,0,0"
                    Padding="24"
                    CornerRadius="10"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <TextBlock Text="Patient Record History"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Previous changes made to this patient's information."
                               Margin="0,6,0,18"
                               Opacity="0.7"/>

                    <TextBlock Text="No record changes have been recorded."
                               Opacity="0.7"
                               Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecordHistory.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding RecordHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding ChangedAtDisplay}"
                                                       Opacity="0.7"/>
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding Changes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,14">
                                                        <TextBlock Text="{Binding FieldName}"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,0,0,8"/>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Background="#F3EEEE"
                                                                    CornerRadius="6"
                                                                    Padding="12"
                                                                    Margin="0,0,6,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="PREVIOUS VALUE"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#8B5555"/>

                                                                    <TextBlock Text="{Binding PreviousValue}"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,5,0,0"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Grid.Column="1"
                                                                    Background="#EAF4EC"
                                                                    CornerRadius="6"
                                                                    Padding="12"
                                                                    Margin="6,0,0,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="NEW VALUE"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#367548"/>

                                                                    <TextBlock Text="{Binding NewValue}"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,5,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Laboratory Results -->
            <Border x:Name="LaboratoryResultsSection"
                    Grid.Row="5"
                    Margin="0,20,0,0"
                    Padding="24"
                    CornerRadius="10"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <DockPanel LastChildFill="False"
                               Margin="0,0,0,18">

                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Laboratory Results"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Laboratory records associated with this patient."
                                       Margin="0,6,0,0"
                                       Opacity="0.7"/>
                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                                Content="+ Add Laboratory Result"
                                Padding="12,7"
                                VerticalAlignment="Center"
                                Click="AddLaboratoryResultButton_Click"/>
                                        </DockPanel>

                    <!-- Laboratory Results ViewModel Status -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               Opacity="0.7"/>

                    <!-- Laboratory Results List -->
                    <ItemsControl ItemsSource="{Binding LaboratoryResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,12">


                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding TestName}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"/>


                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding TestDate,
                                                              Converter={StaticResource RegionalDateOnlyConverter}}"
                                                       Opacity="0.7"/>
                                        </DockPanel>

                                        <TextBlock Text="{Binding Result}"
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding Unit}"
                                                   Opacity="0.7"
                                                   Margin="0,4,0,0"/>

                                        <TextBlock Text="{Binding ReferenceRange}"
                                                   Opacity="0.7"
                                                   Margin="0,4,0,0"/>

                                        <TextBlock Text="{Binding Notes}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"
                                                   Opacity="0.7"/>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,12,0,0">

                                            <Button Content="History"
                                                    Padding="12,6"
                                                    Margin="0,0,8,0"
                                                    Click="LaboratoryResultHistoryButton_Click"/>

                                            <Button Content="Edit"
                                                    Padding="12,6"
                                                    Click="EditLaboratoryResultButton_Click"/>

                                            <Button Content="Archive"
                                                    Padding="12,6"
                                                    Margin="6,0,0,0"
                                                    Click="LaboratoryResultArchiveButton_Click"/>
                                            
                                        </StackPanel>
                                    </StackPanel>

                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Pregnancy History -->
            <Border Grid.Row="6"
                    Margin="0,20,0,0"
                    Padding="24"
                    CornerRadius="10"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>

                    <!-- Pregnancy History Header -->
                    <DockPanel LastChildFill="False"
                               Margin="0,0,0,18">

                        <StackPanel DockPanel.Dock="Left"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Pregnancy History"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Pregnancy records associated with this patient."
                                       Margin="0,6,0,0"
                                       Opacity="0.7"/>
                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                                Content="+ Add Pregnancy Record"
                                Padding="12,7"
                                VerticalAlignment="Center"
                                Click="AddPregnancyButton_Click"/>
                    </DockPanel>

                    <TextBlock Text="No pregnancy records found."
                               Opacity="0.7"
                               Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Pregnancies.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Pregnancies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,12">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Pregnancy Information -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Pregnancy.Status}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Margin="0,8,0,0">
                                                <Run Text="Last menstrual period: "/>
                                                <Run Text="{Binding Pregnancy.LastMenstrualPeriod,
                                                          Converter={StaticResource RegionalDateOnlyConverter},
                                                          TargetNullValue='Not recorded'}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,4,0,0">
                                                <Run Text="Estimated due date: "/>
                                                <Run Text="{Binding Pregnancy.EstimatedDueDate,
                                                          Converter={StaticResource RegionalDateOnlyConverter},
                                                          TargetNullValue='Not recorded'}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,4,0,0">
                                                <Run Text="Pregnancy end date: "/>
                                                <Run Text="{Binding Pregnancy.PregnancyEndDate,
                                                          Converter={StaticResource RegionalDateOnlyConverter},
                                                          TargetNullValue='Not recorded'}"/>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Pregnancy.Notes, TargetNullValue='No notes'}"
                                                       Margin="0,8,0,0"
                                                       TextWrapping="Wrap"
                                                       Opacity="0.75"/>
                                        </StackPanel>

                                        <!-- Pregnancy Actions -->
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Top"
                                                    Margin="16,0,0,0">

                                            <Button Content="Edit"
                                                    Padding="12,6"
                                                    Margin="0,0,8,0"
                                                    Click="EditPregnancyButton_Click"/>

                                            <Button Content="View Prenatal Visits"
                                                    Padding="12,6"
                                                    Margin="0,0,8,0"
                                                    Click="ViewPrenatalVisitsButton_Click"/>

                                            <Button Content="History"
                                                    Padding="12,6"
                                                    Click="PregnancyHistoryButton_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasHistory}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
