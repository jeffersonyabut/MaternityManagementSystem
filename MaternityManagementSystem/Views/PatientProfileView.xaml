<UserControl x:Class="MaternityManagementSystem.Views.PatientProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">

                <Button Content="← Back to Patients"
            Padding="12,7"
            HorizontalAlignment="Left"
            Margin="0,0,0,20"
            Click="BackToPatientsButton_Click"/>

                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Patient Profile"
                       FontSize="28"
                       FontWeight="SemiBold"/>

                        <TextBlock Text="View registered patient information."
                       FontSize="14"
                       Opacity="0.7"
                       Margin="0,6,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                Content="Edit Patient"
                Padding="18,10"
                VerticalAlignment="Center"
                Click="EditPatientButton_Click"/>
                </DockPanel>

            </StackPanel>



            <!-- Patient details -->
            <Border Grid.Row="1"
                    Padding="24"
                    CornerRadius="10"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <TextBlock Text="{Binding Patient.PatientNumber}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Opacity="0.65"/>

                    <TextBlock Margin="0,8,0,24"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Text="{Binding Patient.FirstName}"/>

                    <TextBlock Text="Personal Information"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,16">
                            <TextBlock Text="First Name" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.FirstName}" FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                            <TextBlock Text="Middle Name" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.MiddleName, TargetNullValue=—}" FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,16">
                            <TextBlock Text="Last Name" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.LastName}" FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                            <TextBlock Text="Date of Birth" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.DateOfBirth, StringFormat={}{0:MMMM dd, yyyy}, TargetNullValue=Not provided}" FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Sex" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.Sex, TargetNullValue=Not provided}" FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="Civil Status" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.CivilStatus, TargetNullValue=Not provided}" FontSize="15"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,0,0,24"/>

                    <TextBlock Text="Contact Information"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Contact Number" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.ContactNumber, TargetNullValue=Not provided}"
                                       TextWrapping="Wrap"
                                       FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Email" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.Email, TargetNullValue=Not provided}"
                                       TextWrapping="Wrap"
                                       FontSize="15"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Address" Opacity="0.65"/>
                        <TextBlock Text="{Binding Patient.Address, TargetNullValue=Not provided}"
                                   TextWrapping="Wrap"
                                   FontSize="15"/>
                    </StackPanel>

                    <Separator Margin="0,0,0,24"/>

                    <TextBlock Text="Emergency Contact"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Contact Name" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.EmergencyContactName, TargetNullValue=Not provided}"
                                       TextWrapping="Wrap"
                                       FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Contact Number" Opacity="0.65"/>
                            <TextBlock Text="{Binding Patient.EmergencyContactNumber, TargetNullValue=Not provided}"
                                       TextWrapping="Wrap"
                                       FontSize="15"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>


            <!-- Pregnancy History -->
            <Border Grid.Row="3"
        Margin="0,20,0,0"
        Padding="24"
        CornerRadius="10"
        Background="{DynamicResource MaterialDesignPaper}">

                
                <StackPanel>

                    <Button Content="+ Add Pregnancy Record"
                    Padding="12,7"
                    HorizontalAlignment="Right"
                    Click="AddPregnancyButton_Click"/>
                    
                    <TextBlock Text="Pregnancy History"
                   FontSize="20"
                   FontWeight="SemiBold"/>

                    <TextBlock Text="Pregnancy records associated with this patient."
                   Margin="0,6,0,18"
                   Opacity="0.7"/>

                    <TextBlock Text="No pregnancy records found."
                   Opacity="0.7"
                   Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Pregnancies.Count}"
                                     Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Pregnancies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,12">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Status}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                            <TextBlock Margin="0,8,0,0">
                                    <Run Text="Last menstrual period: "/>
                                    <Run Text="{Binding LastMenstrualPeriod,
                                        TargetNullValue='Not recorded',
                                        StringFormat={}{0:MMM dd, yyyy}}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,4,0,0">
                                    <Run Text="Estimated due date: "/>
                                    <Run Text="{Binding EstimatedDueDate,
                                        TargetNullValue='Not recorded',
                                        StringFormat={}{0:MMM dd, yyyy}}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,4,0,0">
                                    <Run Text="Pregnancy end date: "/>
                                    <Run Text="{Binding PregnancyEndDate,
                                        TargetNullValue='Not recorded',
                                        StringFormat={}{0:MMM dd, yyyy}}"/>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Notes,
                                                   TargetNullValue='No notes'}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Opacity="0.75"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="Edit"
                                                Padding="12,6"
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Top"
                                                Click="EditPregnancyButton_Click"/>

                                        
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>


            <!-- Loading / error status -->
            <TextBlock Grid.Row="2"
                       Text="{Binding StatusMessage}"
                       Margin="4,12,0,0"
                       TextWrapping="Wrap"
                       Opacity="0.8"/>
        </Grid>
    </ScrollViewer>
</UserControl>
