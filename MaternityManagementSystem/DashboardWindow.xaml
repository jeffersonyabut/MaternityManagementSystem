<Window x:Class="MaternityManagementSystem.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:MaternityManagementSystem.Themes"
        Title="Golddie | Clinic Management"
        Height="720"
        Width="1200"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource NavigationText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource NavigationHoverBackground}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource NavigationPressedBackground}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Persistent Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackground}">

            <DockPanel LastChildFill="True">

                <!-- Sidebar Header -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="24,28,24,32">

                    <TextBlock Text="GOLDDIE"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock x:Name="ClinicNameText"
                               Text="Maternity Clinic"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="2,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel DockPanel.Dock="Top"
                            HorizontalAlignment="Stretch">

                    <TextBlock Text="WORKSPACE"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="24,0,0,12"/>

                    <!-- Dashboard Navigation Button -->
                    <Button Content="Dashboard"
                            HorizontalAlignment="Stretch"
                            Click="DashboardButton_Click">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource SidebarButtonStyle}">

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}"
                                                 Value="DashboardView">
                                        <Setter Property="Background"
                                                Value="{DynamicResource NavigationSelectedBackground}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource NavigationSelectedText}"/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Patients Navigation Button -->
                    <Button Content="Patients"
                            HorizontalAlignment="Stretch"
                            Click="PatientsButton_Click">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource SidebarButtonStyle}">

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}"
                                                 Value="PatientsView">
                                        <Setter Property="Background"
                                                Value="{DynamicResource NavigationSelectedBackground}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource NavigationSelectedText}"/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>
                    </Button>


                    <!-- Appointments Navigation Button -->
                    <Button Content="Appointments"
                            HorizontalAlignment="Stretch"
                            Click="AppointmentsButton_Click">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource SidebarButtonStyle}">

                                <Style.Triggers>

                                    <!-- Highlight Appointment Overview -->
                                    <DataTrigger Binding="{Binding CurrentPage}"
                                                 Value="AppointmentOverviewView">
                                        <Setter Property="Background"
                                                Value="{DynamicResource NavigationSelectedBackground}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource NavigationSelectedText}"/>
                                    </DataTrigger>

                                    <!-- Highlight Appointment Registration -->
                                    <DataTrigger Binding="{Binding CurrentPage}"
                                                 Value="AppointmentRegistrationView">
                                        <Setter Property="Background"
                                                Value="{DynamicResource NavigationSelectedBackground}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource NavigationSelectedText}"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>


                    <!-- Reports Navigation Button -->
                    <Button Content="Reports"
                            HorizontalAlignment="Stretch"
                            Click="ReportsButton_Click">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource SidebarButtonStyle}">

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}"
                                                 Value="ReportsView">
                                        <Setter Property="Background"
                                                Value="{DynamicResource NavigationSelectedBackground}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource NavigationSelectedText}"/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>
                    </Button>



                    <!-- Staff Management Navigation Button -->
                    <Button x:Name="StaffManagementButton"
                            Content="Staff Management"
                            HorizontalAlignment="Stretch">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource SidebarButtonStyle}">

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}"
                                                 Value="StaffManagementView">
                                        <Setter Property="Background"
                                                Value="{DynamicResource NavigationSelectedBackground}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource NavigationSelectedText}"/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>
                    </Button>


                    <!-- Audit Log Management Navigation Button -->
                    <Button x:Name="AuditLogManagementButton"
                            Content="Audit Log Management"
                            HorizontalAlignment="Stretch"
                            Click="AuditLogManagementButton_Click">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource SidebarButtonStyle}">

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}"
                                                 Value="AuditLogManagementView">
                                        <Setter Property="Background"
                                                Value="{DynamicResource NavigationSelectedBackground}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource NavigationSelectedText}"/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>
                    </Button>



                    <!-- SMS Reminder Monitoring Navigation Button -->
                    <Button x:Name="SmsReminderMonitoringButton"
                            Content="SMS Reminder Monitoring"
                            HorizontalAlignment="Stretch"
                            Click="SmsReminderMonitoringButton_Click">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource SidebarButtonStyle}">

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}"
                                                 Value="AppointmentSmsReminderMonitoringView">
                                        <Setter Property="Background"
                                                Value="{DynamicResource NavigationSelectedBackground}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource NavigationSelectedText}"/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>
                    </Button>


                    <!-- System Settings Navigation Button -->
                    <Button x:Name="SystemSettingsButton"
                            Content="System Settings"
                            HorizontalAlignment="Stretch"
                            Click="SystemSettingsButton_Click">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource SidebarButtonStyle}">

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}"
                                                 Value="SystemSettingsView">
                                        <Setter Property="Background"
                                                Value="{DynamicResource NavigationSelectedBackground}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource NavigationSelectedText}"/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>
                    </Button>




                </StackPanel>


                <!-- Sidebar Footer -->
                <StackPanel DockPanel.Dock="Bottom"
                            Margin="12,12,12,16">

                    <Button Content="Sign out"
                            HorizontalAlignment="Stretch"
                            Click="LogoutButton_Click">

                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                    BasedOn="{StaticResource SidebarButtonStyle}">

                                <Setter Property="Foreground" Value="#F0B8B8"/>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="Golddie · Clinic System"
                               Foreground="#A7A5BF"
                               FontSize="11"
                               Margin="12,12,12,4"
                               HorizontalAlignment="Center"/>
                </StackPanel>


            </DockPanel>
        </Border>

        <!-- Main Application Area -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBackground}"
                    Padding="28,0"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0,0,1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Clinic Management"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <TextBlock Text="Theme"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,8,0"/>
                        <ComboBox x:Name="ThemePreferenceComboBox"
                                  Width="112"
                                  Height="32"
                                  VerticalContentAlignment="Center"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="ThemePreferenceComboBox_SelectionChanged">
                            <ComboBoxItem Content="System"
                                          Tag="{x:Static themes:ThemePreference.System}"/>
                            <ComboBoxItem Content="Light"
                                          Tag="{x:Static themes:ThemePreference.Light}"/>
                            <ComboBoxItem Content="Dark"
                                          Tag="{x:Static themes:ThemePreference.Dark}"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">

                        <TextBlock x:Name="UserInfoText"
                                   Text="Signed in"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="Active session"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryText}"
                                   HorizontalAlignment="Right"
                                   Margin="0,3,0,0"/>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Swappable Content -->
            <ContentControl Grid.Row="1"
                            x:Name="ContentArea"
                            Content="{Binding CurrentView}"/>

        </Grid>
    </Grid>
</Window>
